MARIADB_ROOT_PASSWORD=replace-with-a-long-random-value
MARIADB_APP_PASSWORD=replace-with-a-different-long-random-value

# Optional initial administrator. Set BOTH values before first startup.
# No default administrator is created; existing regular accounts are never elevated.
# Password: at least 12 characters, upper/lower case, digit and special character.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Existing-account recovery is CLI-only (never an environment setting):
# docker compose exec heimevernet dotnet HeimevernetInnlevering1.dll --promote-admin operator@example.test
# Replace the example with the existing account email; see README for precautions.

# For non-Docker deployments, optionally set DataProtection__KeyPath to a persistent
# directory outside the repository. Docker persists /app/keys in identity-keys.
# Use HTTPS in production; protect the key directory/volume like a credential.
