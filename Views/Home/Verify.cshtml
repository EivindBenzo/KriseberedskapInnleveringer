@model HeimevernetInnlevering1.ViewModels.DataPageViewModel
@using HeimevernetInnlevering1.Models
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    var mine = ViewBag.Mine is true;
    var overlay = ViewBag.ResourcesOverlay is true;
    ViewData["Title"] = "Ressurser";
    var now = DateTime.UtcNow;
    var resourceIconUrls = new[] { "car", "excavator", "drone", "generator", "personnel", "toolbox", "unknown" }
        .SelectMany(file => new[] { file, file + "-available", file + "-unavailable" })
        .ToDictionary(file => file, file => FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content($"~/images/resources/{file}.svg")));
}
<section class="data-container resource-overview">
    <link rel="stylesheet" href="~/css/resource-management.css" asp-append-version="true" />
    <div class="page-heading">
        <div><span class="eyebrow">Oversikt og administrasjon</span><h1>Ressurser</h1></div>
        <a asp-action="Map" asp-route-register="true" class="btn-submit" data-map-register>+ Registrer ressurs</a>
    </div>
    @if (TempData["MapSuccess"] is string success)
    {
        <p class="info" role="status">@success</p>
    }
    @if (TempData["MapError"] is string error)
    {
        <p class="workspace-alert" role="alert">@error</p>
    }
    <nav class="section-nav" aria-label="Ressursutvalg">
        <a asp-action="Resources" asp-route-type="@ViewBag.SelectedType" asp-route-query="@ViewBag.Query" asp-route-city="@ViewBag.City" asp-route-eligible="@ViewBag.Eligible" data-resources-link aria-current="@(!mine ? "page" : null)">Alle ressurser</a>
        <a asp-action="Resources" asp-route-mine="true" asp-route-type="@ViewBag.SelectedType" asp-route-query="@ViewBag.Query" asp-route-city="@ViewBag.City" asp-route-eligible="@ViewBag.Eligible" data-resources-link aria-current="@(mine ? "page" : null)">Mine ressurser</a>
        @if (!overlay)
        {
            <a asp-action="Map" data-map-back>Åpne kart</a>
        }
    </nav>
    <form asp-action="Resources" method="get" class="filter-bar">
        @if (overlay)
        {
            <input type="hidden" name="overlay" value="true" />
        }
        <input type="hidden" name="mine" value="@mine.ToString().ToLowerInvariant()" />
        <div class="form-group resource-city">
            <label for="resourceCity">By / sted</label>
            <input id="resourceCity" name="city" value="@ViewBag.City" class="form-control" maxlength="120" autocomplete="off"
                   role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="resourceCityOptions" />
            <ul id="resourceCityOptions" class="resource-city-options" role="listbox" aria-label="Byer med ressurser" hidden>
                @foreach (var city in Model.Cities)
                {
                    <li role="option" id="resource-city-@Model.Cities.ToList().IndexOf(city)" data-city="@city.Name" data-count="@city.Count" aria-selected="false">@city.Name (@city.Count)</li>
                }
            </ul>
        </div>
        <div class="form-group">
            <label for="query">Navn eller sted</label>
            <input id="query" name="query" value="@ViewBag.Query" class="form-control" maxlength="200" />
        </div>
        <div class="form-group">
            <label for="type">Ressurstype</label>
            <select id="type" name="type" class="form-control">
                <option value="">Alle typer</option>
                @foreach (var type in MapSubmissionViewModel.ResourceTypes)
                {
                    <option value="@type" selected="@(type == (string?)ViewBag.SelectedType)">@type</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="eligible">Operativ status</label>
            <select id="eligible" name="eligible" class="form-control">
                <option value="false">Alle registrerte</option>
                <option value="true" selected="@(ViewBag.Eligible is true)">Kan forespørres nå</option>
            </select>
        </div>
        <button type="submit" class="btn-secondary">Vis resultater</button>
    </form>
    <p class="resource-management-status" role="status" tabindex="-1"></p>
    <dialog class="resource-delete-dialog" aria-labelledby="resourceDeleteTitle" aria-describedby="resourceDeleteName">
        <h2 id="resourceDeleteTitle">Slett ressurs?</h2>
        <p id="resourceDeleteName"></p>
        <p class="resource-delete-error" role="alert" tabindex="-1"></p>
        <form method="post" data-resource-delete-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="version" />
            <button type="button" class="btn-secondary" data-delete-cancel autofocus>Avbryt</button>
            <button type="submit" class="btn-danger">Slett</button>
        </form>
    </dialog>
    <div class="results-heading">
        <h2>@(mine ? "Mine ressurser" : "Alle ressurser") <span class="count-badge">@Model.MapSubmissions.Count</span></h2>
        <small class="resource-meta">Status ved lasting · @now.ToString("dd.MM.yyyy HH:mm") UTC</small>
    </div>
    <details class="workspace-disclosure">
        <summary>Hva betyr statusene?</summary>
        <p>Registrering er ikke en godkjenning. Bare tilgjengelige ressurser med gyldig godkjenning kan forespørres. Kartplassering påvirker ikke tilgjengelighet eller aktive forespørsler.</p>
    </details>
    @if (Model.MapSubmissions.Count == 0)
    {
        <p>Ingen ressurser passer valget. Prøv en annen type eller fjern søket.</p>
    }
    <div class="resource-list">
        @foreach (var r in Model.MapSubmissions)
        {
            var status = ResourceOperationalStatus.From(r, now);
            <div class="resource-row" data-resource-row="@r.Id" data-city="@ResourceCity.FromLocation(r.LocationName)">
                <div>
                    <h2><img data-resource-icon="@r.ResourceType" alt="" width="32" height="32" data-resource-status="@System.Text.Json.JsonSerializer.Serialize(status)" /> @r.ResourceName</h2>
                    <p class="resource-meta">@r.ResourceType · @r.LocationName</p>
                    <details class="resource-facts">
                        <summary>Detaljer om ressursen</summary>
                        <dl>
                            <div><dt>Sist oppdatert</dt><dd>@((r.UpdatedAtUtc ?? r.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm")) UTC</dd></div>
                            <div><dt>Koordinater</dt><dd>@r.Latitude.ToString("F5"), @r.Longitude.ToString("F5")</dd></div>
                            @if (!string.IsNullOrWhiteSpace(r.Capability))
                            {
                                <div><dt>Kapasitet</dt><dd>@r.Capability</dd></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(r.TransportRequirements))
                            {
                                <div><dt>Transportbehov</dt><dd>@r.TransportRequirements</dd></div>
                            }
                            @if (r.VerificationExpiresAtUtc.HasValue)
                            {
                                <div><dt>Godkjenning gjelder til</dt><dd>@r.VerificationExpiresAtUtc.Value.ToString("dd.MM.yyyy HH:mm") UTC</dd></div>
                            }
                        </dl>
                    </details>
                </div>
                <div class="resource-status">
                    <h3>Status</h3>
                    <span class="status-badge @(r.Availability == ResourceAvailability.Available ? "status-positive" : "status-warning")">@status.Availability</span>
                    <p class="resource-meta">Godkjenning: @status.Verification</p>
                    @if (!r.IsOnMap)
                    {
                        <span class="status-badge">Ikke på kartet</span>
                    }
                </div>
                <div class="resource-actions">
                    @if (r.IsOnMap)
                    {
                        <a asp-action="Map" asp-route-focus="@r.Id" class="btn-secondary" data-map-focus="@r.Id"
                           data-lat="@r.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-lng="@r.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture)">Vis på kart</a>
                    }
                    @if (ResourcePermissions.CanManage(User, r.OwnerId))
                    {
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn-secondary">Rediger</a>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Operations" asp-action="Index" asp-fragment="needs" class="btn-secondary">Koordiner</a>
                    }
                    @if (ResourcePermissions.CanManage(User, r.OwnerId))
                    {
                        <div class="resource-destructive-actions">
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn-danger" data-resource-delete="@r.Id" data-resource-name="@r.ResourceName" data-version="@r.ConcurrencyToken">Slett</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    @if (User.IsInRole("Admin"))
    {
        <details class="danger-zone" id="reset-map">
            <summary>Administrer kartplasseringer</summary>
            <h2>Nullstill ressurskartet</h2>
            <p>Fjerner alle nåværende ressursmarkører fra kartet, også utenfor valgt filter. Ressursene beholdes her. Tilgjengelighet, reservasjoner og forespørselshistorikk endres ikke.</p>
            <p>Plasser en ressurs igjen via «Rediger». Reserverte og tildelte ressurser må frigjøres før de kan redigeres.</p>
            <form asp-action="ResetMap" method="post">
                <label class="confirmation-label"><input type="checkbox" name="confirmed" value="true" required /> Jeg bekrefter at alle ressursmarkører skal fjernes fra kartet.</label>
                <button type="submit" class="btn-danger">Nullstill alle kartplasseringer</button>
            </form>
        </details>
    }
    @if (Model.FormSubmissions.Count > 0)
    {
        <details>
            <summary>Eldre meldinger · @(User.IsInRole("Admin") ? "administratortilgang" : "bare dine egne") (@Model.FormSubmissions.Count)</summary>
            <p>Historiske meldinger er ikke operative behov. Nye behov håndteres av autorisert koordinator under Behov.</p>
            @foreach (var s in Model.FormSubmissions)
            {
                <div class="resource-row">
                    <div><p>@s.Description</p><p>@s.LocationName</p><small>@s.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm") UTC</small></div>
                    <div><p>@s.FirstName @s.LastName</p><p>@s.Email</p></div>
                </div>
            }
        </details>
    }
</section>
@if (ViewBag.ResourcesPartial is not true)
{
    <div>
    <script src="~/js/resource-icons.js" asp-append-version="true" data-icon-base="@Url.Content("~/images/resources/")" data-icon-urls="@System.Text.Json.JsonSerializer.Serialize(resourceIconUrls)"></script>
    <script src="~/js/resource-management.js" asp-append-version="true"></script>
    </div>
}
