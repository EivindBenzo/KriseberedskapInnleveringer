@model HeimevernetInnlevering1.ViewModels.DataPageViewModel
@using HeimevernetInnlevering1.Models
@using HeimevernetInnlevering1.Services
@{
    var mine = ViewBag.Mine is true;
    var history = ViewBag.ResourceHistory is true;
    ViewData["Title"] = "Ressurser";
    var now = DateTime.UtcNow;
    var valgtBy = (string?)ViewBag.City ?? "";
    var typer = (ViewBag.Ressurstyper as List<string>) ?? HeimevernetInnlevering1.Data.SeedData.RessurstypeNavn.ToList();
    var antallTilgjengelig = Model.Ressurser.Count(x => x.Status == Statuser.Ressurs.Tilgjengelig);
    var iGår = now.AddDays(-1);
    var opptatt = Model.Ressurser.Count(x => Statuser.Ressurs.Opptatt.Contains(x.Status));
    var oppfølging = Model.Ressurser.Count(x => !ResourceOperationalStatus.From(x, now).IsEligible && !Statuser.Ressurs.Opptatt.Contains(x.Status));
    // Endring siden i går: nye tilgjengelige ressurser, og ressurser som er godkjent det siste døgnet (ferdig fulgt opp).
    var nyeTilgjengelige = Model.Ressurser.Count(x => x.Status == Statuser.Ressurs.Tilgjengelig && x.Registrert >= iGår);
    var ferdigFulgtOpp = Model.Ressurser.Count(x => x.Verifiseringer.Any(v => v.Resultat == Statuser.Resultat.Godkjent && v.Tidspunkt >= iGår));
    string Endring(int n) => n > 0 ? $"↑ +{n} siden i går" : n < 0 ? $"↓ {n} siden i går" : "↔ Uendret";
    var opptattIGår = Model.Ressurser.Count(x => Statuser.Ressurs.Opptatt.Contains(x.Status) && x.Registrert >= iGår);
}
<section class="data-container resource-overview">
    <header class="res-hero">
        <div class="res-hero-top">
            <h1>Ressurser</h1>
            <p>Registrer, forvalt og følg opp beredskapsressurser i ditt område.</p>
            <div class="res-hero-actions">
                @if (User.IsInRole(AppRoles.Ressursleverandor))
                {
                    <a asp-action="Map" asp-route-register="true" class="res-btn is-solid"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>Registrer ressurs</a>
                }
                <a asp-action="Map" asp-route-type="@ViewBag.SelectedType" asp-route-city="@ViewBag.City" asp-route-mine="@(mine ? "true" : null)" asp-route-eligible="@(ViewBag.Eligible is true ? "true" : null)" class="res-btn is-ghost"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 6 6-2 6 2 6-2v14l-6 2-6-2-6 2z"/><path d="M9 4v14M15 6v14"/></svg>Åpne kart</a>
            </div>
        </div>
        <div class="res-kpis" aria-label="Sammendrag">
            <div class="res-kpi is-good">
                <span class="res-kpi-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5M3 17.500l9 5 9-5"/></svg></span>
                <div><small>Tilgjengelige nå</small><strong>@antallTilgjengelig</strong><em class="@(nyeTilgjengelige > 0 ? "is-up" : "")">@Endring(nyeTilgjengelige)</em></div>
            </div>
            <div class="res-kpi is-warn">
                <span class="res-kpi-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.300 3.900 1.800 18a2 2 0 0 0 1.700 3h17a2 2 0 0 0 1.700-3L13.700 3.900a2 2 0 0 0-3.400 0z"/><path d="M12 9v4M12 17h.01"/></svg></span>
                <div><small>Trenger oppfølging</small><strong>@oppfølging</strong><em class="@(ferdigFulgtOpp > 0 ? "is-down" : "")">@Endring(-Math.Min(ferdigFulgtOpp, 99))</em></div>
            </div>
            <div class="res-kpi is-info">
                <span class="res-kpi-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg></span>
                <div><small>På vei / i bruk</small><strong>@opptatt</strong><em>@Endring(opptattIGår)</em></div>
            </div>
            <div class="res-kpi">
                <span class="res-kpi-icon"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span>
                <div><small>Sist oppdatert</small><strong class="is-date">@now.ToLocalTime().ToString("dd.MM.yyyy 'kl.' HH:mm")</strong></div>
                <i class="res-kpi-info" title="Tallene er hentet da siden ble lastet. Endring viser siste 24 timer." aria-label="Tallene er hentet da siden ble lastet. Endring viser siste 24 timer.">i</i>
            </div>
        </div>
    </header>    @if (TempData["MapSuccess"] is string success)
    {
        <p class="info" role="status">@success</p>
    }
    @if (TempData["MapError"] is string error)
    {
        <p class="workspace-alert" role="alert">@error</p>
    }
    <nav class="section-nav" aria-label="Ressursutvalg">
        <a asp-action="Resources" asp-route-type="@ViewBag.SelectedType" asp-route-city="@ViewBag.City" asp-route-eligible="@ViewBag.Eligible" aria-current="@(!mine && !history ? "page" : null)">Alle ressurser</a>
        @if (User.IsInRole(AppRoles.Ressursleverandor))
        {
            <a asp-action="Resources" asp-route-mine="true" asp-route-type="@ViewBag.SelectedType" asp-route-city="@ViewBag.City" asp-route-eligible="@ViewBag.Eligible" aria-current="@(mine ? "page" : null)">Mine ressurser</a>
        }
        @if (User.IsInRole(AppRoles.Kriseledelse))
        {
            <a asp-action="Resources" asp-route-history="true" aria-current="@(history ? "page" : null)">Ressurshistorikk</a>
        }
    </nav>
    @if (history)
    {
        <h2>Ressurshistorikk</h2>
        <p>De siste 500 registreringene og slettingene. Eldre poster kan mangle ressursopplysninger.</p>
        @if (Model.History.Count == 0)
        {
            <p>Ingen registreringer eller slettinger er loggført ennå.</p>
        }
        <div class="resource-list">
            @foreach (var entry in Model.History)
            {
                <article class="resource-row">
                    <div>
                        <h3>@(entry.Action == "RessursRegistrert" ? "Ressurs lagt til" : "Ressurs slettet")</h3>
                        <p>@entry.Description</p>
                        @if (entry.ResourceId.HasValue)
                        {
                            <small>Ressurs #@entry.ResourceId</small>
                        }
                    </div>
                    <div>
                        <p>Utført av @entry.Actor</p>
                        <time datetime="@entry.OccurredAtUtc.ToString("O")">@entry.OccurredAtUtc.ToString("dd.MM.yyyy HH:mm:ss") UTC</time>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
    <div>
    <div class="type-chips" role="group" aria-label="Filtrer på ressurstype">
        <a asp-action="Resources" asp-route-mine="@(mine ? "true" : null)" asp-route-city="@ViewBag.City" asp-route-eligible="@(ViewBag.Eligible is true ? "true" : null)" class="type-chip @(string.IsNullOrEmpty((string?)ViewBag.SelectedType) ? "is-active" : "")">Alle</a>
        @foreach (var typ in typer)
        {
            <a asp-action="Resources" asp-route-type="@typ" asp-route-mine="@(mine ? "true" : null)" asp-route-city="@ViewBag.City" asp-route-eligible="@(ViewBag.Eligible is true ? "true" : null)" class="type-chip @(typ == (string?)ViewBag.SelectedType ? "is-active" : "")">@typ</a>
        }
    </div>
    <form asp-action="Resources" method="get" class="filter-bar">
        <input type="hidden" name="mine" value="@mine.ToString().ToLowerInvariant()" />
        @* Byene og antallet ressurser i hver by regnes ut på serveren (ResourceCity.Aggregate). *@
        <div class="form-group">
            <label for="resourceCity">By</label>
            <select id="resourceCity" name="city" class="form-control">
                <option value="">Alle byer</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city.Name" selected="@(string.Equals(city.Name, valgtBy, StringComparison.OrdinalIgnoreCase))">@city.Name (@city.Count)</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="type">Ressurstype</label>
            <select id="type" name="type" class="form-control">
                <option value="">Alle typer</option>
                @foreach (var type in (ViewBag.Ressurstyper as List<string>) ?? HeimevernetInnlevering1.Data.SeedData.RessurstypeNavn.ToList())
                {
                    <option value="@type" selected="@(type == (string?)ViewBag.SelectedType)">@type</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label for="eligible">Operativ status</label>
            <select id="eligible" name="eligible" class="form-control">
                <option value="false">Alle registrerte</option>
                <option value="true" selected="@(ViewBag.Eligible is true)">Kan forespørres nå</option>
            </select>
        </div>
        <button type="submit" class="btn-secondary">Vis resultater</button>
    </form>
    <div class="results-heading">
        <h2>@(mine ? "Mine ressurser" : "Alle ressurser") <span class="count-badge">@Model.Ressurser.Count</span></h2>
        <small class="resource-meta">Status ved lasting · @now.ToString("dd.MM.yyyy HH:mm") UTC</small>
    </div>
    <details class="workspace-disclosure">
        <summary>Hva betyr statusene?</summary>
        <p>Registrering er ikke en godkjenning. Bare tilgjengelige ressurser med gyldig godkjenning kan forespørres. Etter en tildeling er fullført, blir ressursen «returnert» og må verifiseres på nytt.</p>
    </details>
    @if (Model.Ressurser.Count == 0)
    {
        <p>Ingen ressurser passer valget. Prøv en annen type eller fjern søket.</p>
    }
    <div class="resource-list is-grid">
        @foreach (var r in Model.Ressurser)
        {
            var status = ResourceOperationalStatus.From(r, now);
            var typeNavn = r.Ressurstype?.Navn ?? "Ukjent";
            var godkjentTil = WorkflowEligibility.GodkjentTil(r);
            <div class="resource-row resource-card @(r.Status == Statuser.Ressurs.Tilgjengelig ? "is-available" : "is-unavailable")" id="ressurs-@r.RessursID">
                <div>
                    <h2><img src="@Url.Content(RessursIkon.Sti(typeNavn, status))" alt="" width="32" height="32" /> @r.Navn</h2>
                    <p class="resource-meta">@typeNavn</p>
                    <p class="resource-place"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>@NorwegianPlaces.Display(r.Stedsnavn, r.Breddegrad, r.Lengdegrad)</p>
                    <details class="resource-facts">
                        <summary>Detaljer om ressursen</summary>
                        <dl>
                            <div><dt>Registrert</dt><dd>@r.Registrert.ToString("dd.MM.yyyy HH:mm") UTC</dd></div>
                            <div><dt>Tilgjengelig</dt><dd>fra @r.TilgjengeligFra.ToString("dd.MM.yyyy")@(r.TilgjengeligTil is DateOnly til ? " til " + til.ToString("dd.MM.yyyy") : "")</dd></div>
                            <div><dt>Kontakt</dt><dd>@r.Kontaktperson, @r.Kontakttelefon</dd></div>
                            @if (!string.IsNullOrWhiteSpace(r.Beskrivelse))
                            {
                                <div><dt>Beskrivelse</dt><dd>@r.Beskrivelse</dd></div>
                            }
                            @if (godkjentTil.HasValue)
                            {
                                <div><dt>Godkjenning gjelder til</dt><dd>@godkjentTil.Value.ToString("dd.MM.yyyy HH:mm") UTC</dd></div>
                            }
                        </dl>
                    </details>
                </div>
                <div class="resource-status">
                    <h3>Status</h3>
                    <span class="status-badge @(r.Status == Statuser.Ressurs.Tilgjengelig ? "status-positive" : "status-warning")">@status.Lifecycle</span>
                    <p class="resource-meta">Godkjenning: @status.Verification</p>
                </div>
                <div class="resource-actions">
                    <a asp-action="Map" asp-route-focus="@r.RessursID" asp-fragment="ressurs-@r.RessursID" class="btn-secondary">Vis på kart</a>
                    @if (ResourcePermissions.CanManage(User, r.EierID))
                    {
                        <a asp-action="Edit" asp-route-id="@r.RessursID" class="btn-secondary">Rediger</a>
                    }
                    @if (User.IsInRole(AppRoles.DispatchTeam))
                    {
                        <a asp-controller="Operations" asp-action="Index" asp-route-vis="needs" asp-fragment="needs" class="btn-secondary">Koordiner</a>
                    }
                    @if (ResourcePermissions.CanManage(User, r.EierID))
                    {
                        <div class="resource-destructive-actions">
                            <a asp-action="Delete" asp-route-id="@r.RessursID" class="btn-danger">Slett</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    </div>
    }
</section>
