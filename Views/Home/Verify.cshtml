@model HeimevernetInnlevering1.ViewModels.DataPageViewModel
@{
    ViewData["Title"] = "Verifiser";
}

<div class="data-container">
    <span class="eyebrow">DATABASE-VERIFISERING</span>
    <h1>Verifiser lagret data</h1>
    <p>Denne administratorsiden leser lagrede innmeldinger og ressurser fra MariaDB via Entity Framework.</p>

    <div class="data-status">
        <h2>Antall rader i databasen</h2>
        <p>Skjema-innleveringer: <strong>@Model.FormSubmissions.Count</strong></p>
        <p>Ressurser på kart: <strong>@Model.MapSubmissions.Count</strong></p>
    </div>

    <section class="current-features">
        <h2>Skjema-innleveringer</h2>
        @if (Model.FormSubmissions.Count == 0)
        {
            <p>Ingen rader i tabellen <code>FormSubmissions</code>.</p>
        }
        else
        {
            foreach (var s in Model.FormSubmissions)
            {
                <article class="result-item">
                    <div class="result-label">Id</div>
                    <div class="result-value">@s.Id</div>
                    <div class="result-label">Navn</div>
                    <div class="result-value">@s.FirstName @s.LastName</div>
                    <div class="result-label">E-post</div>
                    <div class="result-value">@s.Email</div>
                    <div class="result-label">Beskrivelse</div>
                    <div class="result-value">@s.Description</div>
                    @if (s.Latitude.HasValue && s.Longitude.HasValue)
                    {
                        <div class="result-label">Koblet lokasjon</div>
                        <div class="result-value">@s.LocationName (@s.Latitude?.ToString("F6"), @s.Longitude?.ToString("F6"))</div>
                    }
                    <div class="info">Lagret (UTC): @s.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")</div>
                </article>
            }
        }
    </section>

    <section class="integration-guide">
        <h2>Ressurser</h2>
        @if (Model.MapSubmissions.Count == 0)
        {
            <p>Ingen rader i tabellen <code>MapSubmissions</code>.</p>
        }
        else
        {
            foreach (var r in Model.MapSubmissions)
            {
                <article class="result-item">
                    <div class="result-label">Id</div>
                    <div class="result-value">@r.Id</div>
                    <div class="result-label">Ressurs</div>
                    <div class="result-value">@r.ResourceName (@r.ResourceType)</div>
                    <div class="result-label">Lokasjon</div>
                    <div class="result-value">@r.LocationName — @r.Latitude.ToString("F6"), @r.Longitude.ToString("F6")</div>
                    <div class="info">Lagret (UTC): @r.CreatedAtUtc.ToString("dd.MM.yyyy HH:mm:ss")</div>
                </article>
            }
        }
    </section>
</div>
