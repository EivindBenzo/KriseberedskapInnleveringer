@using HeimevernetInnlevering1.Models
@model IReadOnlyList<HeimevernetInnlevering1.ViewModels.ContactDirectoryEntry>
@{
    ViewData["Title"] = "Kontaktliste";
    var meg = HeimevernetInnlevering1.Models.ResourcePermissions.BrukerId(User);
    string Initialer(string navn) => string.Concat(navn.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));
    var roller = Model.Select(c => AppRoles.Label(c.Role)).Distinct().OrderBy(x => x).ToList();
    var organisasjoner = Model.Select(c => c.Organization).Where(o => !string.IsNullOrWhiteSpace(o)).Distinct().OrderBy(x => x).ToList();
    string Rollenavn(string r) => r == AppRoles.Kriseledelse ? "krise" : r == AppRoles.Ressursleverandor ? "leverandor" : r == AppRoles.DispatchTeam ? "dispatch" : "annen";
    var steder = Model.Select(c => c.Place).Where(o => !string.IsNullOrWhiteSpace(o)).Distinct().OrderBy(x => x).ToList();
}
<section class="operations-workspace contacts-page kl" aria-labelledby="contacts-heading">
    <div class="kl-hero">
        <div>
            <span class="eyebrow">SAMARBEID OG ANSVAR</span>
            <h1 id="contacts-heading">Kontaktliste</h1>
            <p>Finn riktig kontakt på tvers av roller før du registrerer, verifiserer eller koordinerer en ressurs.</p>
        </div>
        <svg class="kl-art" viewBox="0 0 420 180" aria-hidden="true" focusable="false">
            <circle cx="300" cy="86" r="74" fill="none" stroke="#f9d9b4" stroke-width="2" opacity=".6"/>
            <circle cx="300" cy="86" r="52" fill="none" stroke="#f7c993" stroke-width="2" opacity=".8"/>
            <circle cx="300" cy="86" r="30" fill="#fbe3c6" opacity=".9"/>
            <path d="M0 180V132l62-62 44 40 52-72 70 94 54-46 74 60 64-36v70z" fill="#cfe7e6"/>
            <path d="M0 180v-30l70-50 50 42 60-62 80 76 60-40 100 64z" fill="#b6d9da"/>
            <g fill="#8fc3c4"><path d="M40 180l14-44 14 44z"/><path d="M70 180l12-36 12 36z"/><path d="M350 180l14-46 14 46z"/><path d="M380 180l10-30 10 30z"/><path d="M118 180l12-34 12 34z"/></g>
            <path d="M300 128c-20-26-28-40-28-54a28 28 0 1 1 56 0c0 14-8 28-28 54z" fill="#f08a1c"/>
            <circle cx="300" cy="74" r="11" fill="#fff"/>
        </svg>
    </div>
    @if (TempData["MessageError"] is string error)
    {
        <p class="workspace-alert" role="alert">@error</p>
    }
    @if (TempData["MessageSuccess"] is string success)
    {
        <p class="notice" role="status">@success</p>
    }
    <form class="kl-filters" onsubmit="return false" role="search">
        <label class="kl-search">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.500-3.500"/></svg>
            <input type="search" id="klSearch" placeholder="Søk etter navn, rolle, organisasjon eller kompetanse …" aria-label="Søk i kontakter" autocomplete="off" />
        </label>
        <label class="kl-select">Rolle<select id="klRole"><option value="">Alle roller</option>@foreach (var r in roller) { <option>@r</option> }</select></label>
        <label class="kl-select">Organisasjon<select id="klOrg"><option value="">Alle organisasjoner</option>@foreach (var o in organisasjoner) { <option>@o</option> }</select></label>
        <label class="kl-select">Sted<select id="klPlace"><option value="">Alle steder</option>@foreach (var s in steder) { <option>@s</option> }</select></label>
        <button type="reset" class="kl-reset" id="klReset">Nullstill filtre</button>
    </form>
    <div class="kl-layout">
        <section class="kl-list-card" aria-label="Kontakter">
            <div class="kl-list-head">
                <h2>Kontakter (<span id="klCount">@Model.Count</span>)</h2>
                <label>Sorter: <select id="klSort"><option value="name">Navn (A–Å)</option><option value="role">Rolle</option></select></label>
            </div>
            <ul class="kl-list" id="klList">
            @foreach (var c in Model)
            {
                var rolle = AppRoles.Label(c.Role);
                var json = System.Text.Json.JsonSerializer.Serialize(new
                {
                    id = c.UserId, key = Rollenavn(c.Role), name = c.Name, initials = Initialer(c.Name), role = rolle, org = c.Organization, place = c.Place,
                    phone = c.PhoneNumber, email = c.Email, resources = c.Resources ?? [],
                    activity = (c.Activity ?? []).Select(a => new { text = a.Text, when = a.When.ToUniversalTime().ToString("dd.MM.yyyy HH:mm") + " UTC" }),
                    self = c.UserId == meg
                });
                <li class="kl-row" tabindex="0" role="button" aria-pressed="false" data-contact="@json" data-search="@($"{c.Name} {rolle} {c.Organization} {c.Place}".ToLowerInvariant())" data-name="@c.Name" data-role="@rolle" data-org="@c.Organization" data-place="@c.Place">
                    <span class="kl-avatar is-@Rollenavn(c.Role)">@Initialer(c.Name)</span>
                    <strong class="kl-name">@c.Name</strong>
                    <span class="kl-role is-@Rollenavn(c.Role)">@rolle</span>
                    <span class="kl-org">@c.Organization</span>
                    <span class="kl-place">@if (!string.IsNullOrWhiteSpace(c.Place)) { <text><svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.500 7-12a7 7 0 0 0-14 0c0 5.500 7 12 7 12z"/><circle cx="12" cy="9" r="2.500"/></svg>@c.Place</text> }</span>
                    @if (!string.IsNullOrWhiteSpace(c.PhoneNumber)) { <a href="tel:@c.PhoneNumber" class="kl-phone" data-stop>@c.PhoneNumber</a> } else { <span></span> }
                    <span class="kl-btns">
                        @if (!string.IsNullOrWhiteSpace(c.PhoneNumber)) { <a href="tel:@c.PhoneNumber" class="kl-btn" data-stop><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.900v3a2 2 0 0 1-2.200 2 19.800 19.800 0 0 1-8.600-3.100 19.500 19.500 0 0 1-6-6A19.800 19.800 0 0 1 2.100 4.200 2 2 0 0 1 4.100 2h3a2 2 0 0 1 2 1.700c.1 1 .4 1.900.7 2.800a2 2 0 0 1-.5 2.100L8.100 9.900a16 16 0 0 0 6 6l1.300-1.300a2 2 0 0 1 2.100-.4c.9.3 1.800.6 2.800.7a2 2 0 0 1 1.700 2z"/></svg> Ring</a> }
                        @if (c.UserId != meg) { <button type="button" class="kl-btn contact-message-button" data-stop data-contact-name="@c.Name" data-recipient-id="@c.UserId"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> Melding</button> }
                    </span>
                </li>
            }
            </ul>
            <p class="empty-state" id="klNone" @(Model.Count == 0 ? "" : "hidden")>Ingen kontakter funnet.</p>
        </section>
        <aside class="kl-detail" id="klDetail" aria-live="polite">
            <div class="kl-empty" id="klEmpty">
                <svg viewBox="0 0 24 24" width="40" height="40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.500" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
                <h2>Velg en kontakt</h2>
                <p>Klikk på en kontakt i listen for å se detaljer, ressurser og nylig aktivitet.</p>
            </div>
            <div class="kl-card" id="klCard" hidden>
                <div class="kl-card-top">
                    <span class="kl-avatar is-lg" id="dAvatar"></span>
                    <div class="kl-card-id"><h2 id="dName"></h2><span class="kl-role" id="dRole"></span></div>
                    <span class="kl-chip-ok">Tilgjengelig</span>
                </div>
                <dl class="kl-facts">
                    <div class="kl-fact"><span class="kl-fi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1M14 9h1M9 13h1M14 13h1M9 17h1M14 17h1"/></svg></span><div><dt>Organisasjon</dt><dd id="dOrg"></dd></div></div>
                    <div class="kl-fact"><span class="kl-fi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.900v3a2 2 0 0 1-2.200 2 19.800 19.800 0 0 1-8.600-3.100 19.500 19.500 0 0 1-6-6A19.800 19.800 0 0 1 2.100 4.200 2 2 0 0 1 4.100 2h3a2 2 0 0 1 2 1.700c.1 1 .4 1.900.7 2.800a2 2 0 0 1-.5 2.100L8.100 9.900a16 16 0 0 0 6 6l1.300-1.300a2 2 0 0 1 2.100-.4c.9.3 1.800.6 2.800.7a2 2 0 0 1 1.700 2z"/></svg></span><div><dt>Telefon</dt><dd id="dPhone"></dd></div></div>
                    <div class="kl-fact"><span class="kl-fi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.500 7-12a7 7 0 0 0-14 0c0 5.500 7 12 7 12z"/><circle cx="12" cy="9" r="2.500"/></svg></span><div><dt>Kommune / region</dt><dd id="dPlace"></dd></div></div>
                    <div class="kl-fact"><span class="kl-fi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><div><dt>E-post</dt><dd id="dEmail"></dd></div></div>
                    <div class="kl-fact"><span class="kl-fi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 5 3.500 8 8 9 4.500-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span><div><dt>Ansvarsområde</dt><dd id="dArea"></dd></div></div>
                    <div class="kl-fact"><span class="kl-fi"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><div><dt>Tilgjengelighet</dt><dd><span class="kl-now">&#9679; Tilgjengelig nå</span></dd></div></div>
                </dl>
                <div class="kl-actions">
                    <a class="kl-btn is-solid" id="dCall" href="#"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.900v3a2 2 0 0 1-2.200 2 19.800 19.800 0 0 1-8.600-3.100 19.500 19.500 0 0 1-6-6A19.800 19.800 0 0 1 2.100 4.200 2 2 0 0 1 4.100 2h3a2 2 0 0 1 2 1.700c.1 1 .4 1.900.7 2.800a2 2 0 0 1-.5 2.100L8.100 9.900a16 16 0 0 0 6 6l1.300-1.300a2 2 0 0 1 2.100-.4c.9.3 1.800.6 2.800.7a2 2 0 0 1 1.700 2z"/></svg> Ring</a>
                    <button type="button" class="kl-btn is-solid contact-message-button" id="dMsg" data-contact-name="" data-recipient-id=""><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg> Send melding</button>
                    <a class="kl-btn is-outline" asp-action="Resources"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5z"/><path d="m3 13 9 5 9-5"/></svg> Se ressurser</a>
                    <a class="kl-btn is-outline" asp-controller="Operations" asp-action="Index"><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg> Se hendelser</a>
                </div>
                <div class="kl-sec-head"><h3>Tilknyttede ressurser <span class="count-badge" id="dResCount">0</span></h3><a asp-action="Resources" class="kl-more">Se alle ressurser &rarr;</a></div>
                <div class="kl-chips" id="dRes"></div>
                <div class="kl-sec-head"><h3><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> Nylig aktivitet</h3><a asp-controller="Operations" asp-action="Index" class="kl-more">Se all aktivitet &rarr;</a></div>
                <ul class="kl-activity" id="dAct"></ul>
            </div>
        </aside>
    </div>
</section>
<dialog id="messageComposer" class="message-composer" aria-labelledby="messageComposerHeading">
    <form asp-controller="Messages" asp-action="Send" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="recipientId" id="messageRecipientId" />
        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
        <div class="message-composer-heading">
            <div><span class="eyebrow">NY MELDING</span><h2 id="messageComposerHeading">Til kontakt</h2></div>
            <button type="button" class="message-close" data-close-message aria-label="Lukk">×</button>
        </div>
        <label>Emne <input name="subject" required maxlength="150" autocomplete="off" /></label>
        <label>Melding <textarea name="body" required maxlength="2000"></textarea></label>
        <button type="submit" class="btn-submit">Send melding</button>
    </form>
</dialog>
<script src="~/js/messages.js" asp-append-version="true"></script>
<script src="~/js/contacts.js" asp-append-version="true"></script>
