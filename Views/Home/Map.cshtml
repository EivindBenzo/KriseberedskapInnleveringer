@model RessursSkjemaViewModel
@using System.Globalization
@using System.Text.Json
@using HeimevernetInnlevering1.Models
@{
    ViewData["Title"] = "Kart";
    var isEditing = ViewBag.EditId != null;
    var canRegister = User.IsInRole(AppRoles.Ressursleverandor);
    var registrationOpen = canRegister && (isEditing || !ViewData.ModelState.IsValid || Context.Request.Query["register"] == "true");
    var resources = (ViewBag.Resources as List<Ressurs>) ?? new();
    var ressurstyper = (ViewBag.Ressurstyper as List<string>) ?? HeimevernetInnlevering1.Data.SeedData.RessurstypeNavn.ToList();
    var annenType = Model?.Ressurstype == RessursSkjemaViewModel.AnnenType
        || (!string.IsNullOrEmpty(Model?.Ressurstype) && !ressurstyper.Contains(Model!.Ressurstype));
    var kart = (ViewBag.Kart as KartVisning) ?? KartVisning.Standard;
    var filter = ViewBag.MapFilter as ResourceFilter;
    var valgtType = filter?.Type ?? "";
    var focus = ViewBag.Focus as int?;
    var sted = Context.Request.Query["sted"].ToString();
    var nå = DateTime.UtcNow;
    var harPunkt = kart.Plassering?.Lat is not null;
}

<link rel="stylesheet" href="~/css/workspace-map.css" asp-append-version="true" />
<section class="map-workspace" id="mapWorkspace" data-registration-open="@(registrationOpen ? "true" : "false")" aria-labelledby="workspaceTitle">
    <div class="workspace-heading">
        <div><span class="eyebrow">RESSURSOVERSIKT</span><h1 id="workspaceTitle">Ressurskart</h1></div>
    </div>
    <div class="workspace-toolbar">
        @if (canRegister && !registrationOpen)
        {
            <a asp-action="Map" asp-route-register="true" class="btn-submit">Registrer ressurs</a>
        }
        <a asp-action="Resources" class="btn-secondary">Ressurser og mine ressurser</a>
    </div>
    @if (isEditing)
    {
        <p class="workspace-notice">Endres navn, type, beskrivelse eller plassering, må ressursen verifiseres på nytt.</p>
    }
    @if (TempData["MapSuccess"] is string success)
    {
        <p class="workspace-notice" role="status">@success</p>
    }
    <div class="workspace-grid">
        <aside class="workspace-sidebar" aria-label="Søk og ressurser">
            @* «Finn sted»: skjemaet sendes til serveren, som finner stedet (Stedssok) og flytter kartet dit. *@
            <form asp-action="Map" method="get" class="workspace-search city-search-group">
                <label for="sted">Finn sted</label>
                <div class="workspace-search-row">
                    <input type="text" id="sted" name="sted" value="@sted" class="form-control" placeholder="By eller tettsted" maxlength="120" />
                    @if (registrationOpen && !isEditing)
                    {
                        <input type="hidden" name="register" value="true" />
                    }
                    @if (valgtType.Length > 0)
                    {
                        <input type="hidden" name="type" value="@valgtType" />
                    }
                    <button type="submit" class="btn-secondary">Søk</button>
                </div>
                <small class="workspace-muted">Steder fra <a href="https://www.geonames.org/">GeoNames</a> (<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>)</small>
                @if (kart.Melding is not null)
                {
                    <p class="workspace-muted" role="status">@kart.Melding</p>
                }
                @if (kart.Stedsforslag.Count > 0)
                {
                    <p class="workspace-muted">Mente du:</p>
                    <ul class="place-suggestions">
                        @foreach (var forslag in kart.Stedsforslag)
                        {
                            <li><a asp-action="Map" asp-route-sted="@forslag.Label" asp-route-type="@(valgtType.Length > 0 ? valgtType : null)"
                                   asp-route-register="@(registrationOpen && !isEditing ? "true" : null)">@forslag.Label</a></li>
                        }
                    </ul>
                }
            </form>

            @if (registrationOpen)
            {
            <section id="registrationPanel" class="registration-panel" aria-labelledby="registrationTitle">
                <h2 id="registrationTitle">@(isEditing ? "Rediger ressurs" : "Registrer ressurs")</h2>
                <p class="registration-intro">Beskriv ressursen og marker hvor den finnes. Felt merket * er påkrevd.</p>
                <form method="post" asp-controller="Home" asp-action="@(isEditing ? "Edit" : "Map")" asp-route-id="@ViewBag.EditId" class="workspace-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <fieldset class="registration-section">
                        <legend>Ressursdetaljer</legend>
                        <div class="form-group">
                            <label for="resourceName">Ressursnavn <span class="required">*</span></label>
                            <input type="text" id="resourceName" name="Navn" value="@Model?.Navn" class="form-control" placeholder="f.eks. Lastebil 1" minlength="2" maxlength="150" required />
                            <span asp-validation-for="Navn" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="resourceType">Ressurstype <span class="required">*</span></label>
                            <select id="resourceType" name="Ressurstype" class="form-control" required>
                                <option value="">Velg type</option>
                                @foreach (var type in ressurstyper)
                                {
                                    <option value="@type" selected="@(!annenType && Model?.Ressurstype == type)">@type</option>
                                }
                                <option value="@RessursSkjemaViewModel.AnnenType" selected="@annenType">Annen type …</option>
                            </select>
                            <span asp-validation-for="Ressurstype" class="text-danger"></span>
                        </div>
                        @* Vises bare når «Annen type …» er valgt. Det styres av CSS (:has i workspace-map.css), ikke JavaScript. *@
                        <div class="form-group annen-type" id="nyRessurstypeGroup">
                            <label for="nyRessurstype">Skriv inn ressurstype <span class="required">*</span></label>
                            <input type="text" id="nyRessurstype" name="NyRessurstype" class="form-control" maxlength="100"
                                   value="@(annenType ? (Model?.NyRessurstype ?? (Model?.Ressurstype == RessursSkjemaViewModel.AnnenType ? "" : Model?.Ressurstype)) : "")"
                                   placeholder="f.eks. Snøscooter eller Båt" />
                            <span class="workspace-muted">Typen legges til i listen, slik at andre også kan velge den.</span>
                            <span asp-validation-for="NyRessurstype" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="beskrivelse">Beskrivelse (valgfritt)</label>
                            <textarea id="beskrivelse" name="Beskrivelse" class="form-control" maxlength="1000" rows="2" placeholder="f.eks. 5 kW, 8 seter, krever tilhenger">@Model?.Beskrivelse</textarea>
                            <span asp-validation-for="Beskrivelse" class="text-danger"></span>
                        </div>
                    </fieldset>
                    <fieldset class="registration-section">
                        <legend>Tilgjengelighet og kontakt</legend>
                        <div class="form-row-compact">
                            <div class="form-group">
                                <label for="tilgjengeligFra">Tilgjengelig fra <span class="required">*</span></label>
                                <input type="date" id="tilgjengeligFra" name="TilgjengeligFra" value="@Model?.TilgjengeligFra?.ToString("yyyy-MM-dd")" class="form-control" required />
                                <span asp-validation-for="TilgjengeligFra" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label for="tilgjengeligTil">Tilgjengelig til</label>
                                <input type="date" id="tilgjengeligTil" name="TilgjengeligTil" value="@Model?.TilgjengeligTil?.ToString("yyyy-MM-dd")" class="form-control" />
                                <span asp-validation-for="TilgjengeligTil" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="kontaktperson">Kontaktperson <span class="required">*</span></label>
                            <input type="text" id="kontaktperson" name="Kontaktperson" value="@Model?.Kontaktperson" class="form-control" maxlength="150" required autocomplete="off" placeholder="f.eks. Ola Nordmann" />
                            <span asp-validation-for="Kontaktperson" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="kontakttelefon">Kontakttelefon <span class="required">*</span></label>
                            <input type="tel" id="kontakttelefon" name="Kontakttelefon" value="@Model?.Kontakttelefon" class="form-control" maxlength="20" required autocomplete="off" placeholder="f.eks. 999 99 999" />
                            <span asp-validation-for="Kontakttelefon" class="text-danger"></span>
                        </div>
                    </fieldset>
                    <fieldset class="registration-section" aria-describedby="placementHelp">
                        <legend>Plassering <span class="required">*</span></legend>
                        <p id="placementHelp">Klikk i kartet der ressursen er. Bruk «Finn sted» over for å flytte kartet til riktig by først.</p>
                        <div class="workspace-location"><strong>Valgt plassering</strong><p id="selectedPlace" role="status">@(harPunkt ? Model?.Stedsnavn : "Ingen plassering valgt ennå.")</p></div>
                        <input type="hidden" id="latitude" name="Breddegrad" value="@(harPunkt ? Model!.Breddegrad!.Value.ToString(CultureInfo.InvariantCulture) : "")" />
                        <input type="hidden" id="longitude" name="Lengdegrad" value="@(harPunkt ? Model!.Lengdegrad!.Value.ToString(CultureInfo.InvariantCulture) : "")" />
                        <span asp-validation-for="Breddegrad" class="text-danger"></span>
                    </fieldset>
                    <button type="submit" class="btn-submit">@(isEditing ? "Lagre endringer" : "Registrer ressurs")</button>
                    <a asp-action="Map" class="btn-secondary">Avbryt</a>
                </form>
            </section>
            }

            <section id="resourceResults" class="workspace-results" aria-labelledby="resultsTitle">
                <h2 id="resultsTitle">Ressurser <span class="count-badge">@resources.Count</span></h2>
                @* Filteret sendes til serveren, som bare henter ressursene av valgt type (ResourceQueries). *@
                <form asp-action="Map" method="get" class="map-filter">
                    <label for="resourceFilter">Filtrer ressurstype</label>
                    <div class="workspace-search-row">
                        <select id="resourceFilter" name="type" class="form-control">
                            <option value="">Alle typer</option>
                            @foreach (var gruppe in RessursIkon.Grupper)
                            {
                                <option value="@gruppe" selected="@(valgtType == gruppe)">@gruppe</option>
                            }
                        </select>
                        @if (registrationOpen && !isEditing)
                        {
                            <input type="hidden" name="register" value="true" />
                        }
                        <button type="submit" class="btn-secondary">Vis</button>
                    </div>
                </form>
                @if (resources.Count == 0)
                {
                    <p class="workspace-muted">@(valgtType.Length > 0 ? "Ingen ressurser passer filteret." : "Ingen ressurser er plassert på kartet.")</p>
                }
                <div class="workspace-resource-list">
                @foreach (var r in resources)
                {
                    var status = ResourceOperationalStatus.From(r, nå);
                    var typeNavn = r.Ressurstype?.Navn ?? "Ukjent";
                    <details class="resource-card" id="ressurs-@r.RessursID" open="@(r.RessursID == focus)">
                        <summary><img src="@Url.Content(RessursIkon.Sti(typeNavn, status))" alt="" width="32" height="32" /><span><strong>@r.Navn</strong><small>@typeNavn · @r.Stedsnavn</small><small>@status.Availability · Godkjenning: @status.Verification</small></span></summary>
                        <div class="resource-detail">
                            <dl>
                                <div><dt>Registrert</dt><dd>@r.Registrert.ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture) UTC</dd></div>
                                <div><dt>Tilgjengelig</dt><dd>fra @r.TilgjengeligFra.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture)@(r.TilgjengeligTil is DateOnly til ? " til " + til.ToString("dd.MM.yyyy", CultureInfo.InvariantCulture) : "")</dd></div>
                                <div><dt>Kontakt</dt><dd>@r.Kontaktperson, @r.Kontakttelefon</dd></div>
                                <div><dt>Koordinater</dt><dd>@r.Breddegrad.ToString("F5", CultureInfo.InvariantCulture), @r.Lengdegrad.ToString("F5", CultureInfo.InvariantCulture)</dd></div>
                                @if (!string.IsNullOrEmpty(r.Beskrivelse))
                                {
                                    <div><dt>Beskrivelse</dt><dd>@r.Beskrivelse</dd></div>
                                }
                            </dl>
                            <div class="resource-actions">
                                <a asp-action="Map" asp-route-focus="@r.RessursID" asp-route-type="@(valgtType.Length > 0 ? valgtType : null)" asp-fragment="ressurs-@r.RessursID" class="btn-secondary">Vis på kart</a>
                                @if (ResourcePermissions.CanManage(User, r.EierID))
                                {
                                    <a asp-action="Edit" asp-route-id="@r.RessursID" class="btn-secondary">Rediger</a>
                                    <div class="resource-destructive-actions">
                                        <a asp-action="Delete" asp-route-id="@r.RessursID" class="btn-danger">Slett</a>
                                    </div>
                                }
                            </div>
                        </div>
                    </details>
                }
                </div>
            </section>
        </aside>
        <div class="workspace-map-region" id="mapRegion">
            @if (kart.Plassering is not null)
            {
                <p class="workspace-map-status" role="status">Registrering · klikk i kartet for å plassere ressursen</p>
            }
            <div id="map" aria-label="Kart over ressurser"></div>
            <ul class="map-key" aria-label="Tegnforklaring">
                @foreach (var gruppe in RessursIkon.Grupper)
                {
                    <li><img src="@Url.Content(RessursIkon.Sti(gruppe))" alt="" width="24" height="24" />@gruppe</li>
                }
                <li class="map-key-colors"><span class="dot dot-green"></span>Grønn = tilgjengelig <span class="dot dot-red"></span>Rød = ikke tilgjengelig</li>
            </ul>
        </div>
    </div>
</section>

<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<script src="~/lib/leaflet/leaflet.js"></script>
<script type="application/json" id="kartdata">@Html.Raw(JsonSerializer.Serialize(kart, new JsonSerializerOptions(JsonSerializerDefaults.Web)))</script>
<script src="~/js/kart.js" asp-append-version="true"></script>
