@model MapSubmissionViewModel
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = "Kart";
    var isEditing = ViewBag.EditId != null;
    var resources = (ViewBag.Resources as List<HeimevernetInnlevering1.Models.MapSubmission>) ?? new();
    var resourcesJson = System.Text.Json.JsonSerializer.Serialize(resources.Select(r => new
    {
        id = r.Id,
        name = r.ResourceName,
        type = r.ResourceType,
        location = r.LocationName,
        lat = r.Latitude,
        lng = r.Longitude
    }));
    var selectedPoint = Model?.Latitude is double lat && Model.Longitude is double lng
        && double.IsFinite(lat) && double.IsFinite(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
    var startLat = (selectedPoint ? Model!.Latitude!.Value : 58.1467).ToString(CultureInfo.InvariantCulture);
    var startLng = (selectedPoint ? Model!.Longitude!.Value : 7.9956).ToString(CultureInfo.InvariantCulture);
    var resourceIconUrls = new[] { "car", "excavator", "drone", "generator", "personnel", "toolbox", "unknown" }
        .ToDictionary(file => file, file => FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content($"~/images/resources/{file}.svg")));
}

<div class="map-container">
    <span class="eyebrow">RESSURSER</span>
    <h1>Kart</h1>
    <p>Velg ressurstype, skriv inn navn og klikk i kartet (eller søk etter en by) for å plassere ressursen.</p>

    @if (TempData["MapSuccess"] is string success)
    {
        <p class="info">✅ @success</p>
    }

    <form method="post" asp-controller="Home" asp-action="@(isEditing ? "Edit" : "Map")" asp-route-id="@ViewBag.EditId" class="form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="form-row">
            <div class="form-group">
                <label for="resourceType">Ressurstype <span class="required">*</span></label>
                <select id="resourceType" name="ResourceType" class="form-control" required>
                    <option value="">Velg type</option>
                    @foreach (var type in MapSubmissionViewModel.ResourceTypes)
                    {
                        <option value="@type" selected="@(Model?.ResourceType == type)">@type</option>
                    }
                </select>
                <span asp-validation-for="ResourceType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="resourceName">Ressursnavn <span class="required">*</span></label>
                <input type="text" id="resourceName" name="ResourceName" value="@Model?.ResourceName" class="form-control" placeholder="f.eks. Lastebil 1" required />
                <span asp-validation-for="ResourceName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group city-search-group">
            <label for="citySearch">Søk etter sted</label>
            <div class="city-search-input">
            <input type="text" id="citySearch" class="form-control" placeholder="Skriv et stedsnavn, f.eks. Bergen" autocomplete="off"
                   maxlength="120" role="combobox" aria-autocomplete="list" aria-expanded="false"
                   aria-controls="citySuggestions" aria-describedby="citySearchHelp citySearchStatus" />
            <ul id="citySuggestions" class="city-suggestions" role="listbox" aria-label="Stedsforslag"></ul>
            </div>
            <button type="button" id="citySearchButton" class="btn-secondary">Søk</button>
            <span class="info" id="citySearchStatus" role="status" aria-live="polite" aria-atomic="true"></span>
            <small id="citySearchHelp">Lokale forslag dekker norske byer og tettsteder, ikke adresser. Trykk Søk for fullt søk hos OpenStreetMap.
                Stedsdata: <a href="https://www.geonames.org/">GeoNames</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> (utvalg og bearbeiding).</small>
        </div>

        <div class="form-group">
            <span>Valgt sted</span>
            <p id="selectedPlace" class="info" role="status">@(selectedPoint ? Model?.LocationName : "Ingen plassering valgt. Klikk i kartet eller velg et søkeresultat.")</p>
        </div>

        <input type="hidden" id="latitude" name="Latitude" value="@(selectedPoint ? startLat : "")" />
        <input type="hidden" id="longitude" name="Longitude" value="@(selectedPoint ? startLng : "")" />
        <span asp-validation-for="Latitude" class="text-danger"></span>
        <span asp-validation-for="Longitude" class="text-danger"></span>

        <p class="info">Kartet starter ved Kristiansand, men ingen plassering velges automatisk. Lokale forslag søkes i nettleseren. Søk-knappen sender søketekst, og punktvalg sender koordinater, til OpenStreetMap. Ikke send personlige eller fortrolige opplysninger. Ved manglende treff brukes koordinater.</p>
        <div id="map" aria-label="Interaktivt kart"></div>
        <button type="submit" class="btn-submit">@(isEditing ? "Lagre endringer" : "Send inn")</button>
    </form>

    <h2>Registrerte ressurser (@resources.Count)</h2>
    @if (resources.Count == 0)
    {
        <p>Ingen ressurser er registrert ennå.</p>
    }
    else
    {
        <div class="feature-grid">
            @foreach (var r in resources)
            {
                <div class="feature-card resource-card"
                     data-resource-id="@r.Id"
                     data-lat="@r.Latitude.ToString(CultureInfo.InvariantCulture)"
                     data-lng="@r.Longitude.ToString(CultureInfo.InvariantCulture)">
                    <span class="eyebrow"><img data-resource-icon="@r.ResourceType" alt="" width="32" height="32" /> @r.ResourceType</span>
                    <h3>@r.ResourceName</h3>
                    <p>📍 @r.LocationName<br />@r.Latitude.ToString("F5", CultureInfo.InvariantCulture), @r.Longitude.ToString("F5", CultureInfo.InvariantCulture)</p>
                    <button type="button" class="btn-secondary resource-focus">Vis på kart</button>
                    @if (HeimevernetInnlevering1.Models.ResourcePermissions.CanManage(User, r.OwnerId))
                    {
                        <a asp-action="Edit" asp-route-id="@r.Id" class="btn-secondary">Rediger</a>
                        <a asp-action="Delete" asp-route-id="@r.Id" class="btn-secondary">Slett</a>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .resource-popup strong { display: block; font-size: 1rem; }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/map-controls.css" asp-append-version="true" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/resource-icons.js" asp-append-version="true" data-icon-base="@Url.Content("~/images/resources/")" data-icon-urls="@System.Text.Json.JsonSerializer.Serialize(resourceIconUrls)"></script>
<script src="~/js/map-controls.js" asp-append-version="true"></script>
<script src="~/js/place-search.js" asp-append-version="true"></script>
<script>
    const startLat = @startLat;
    const startLng = @startLng;
    const savedResources = @Html.Raw(resourcesJson);
    const hasSelectedPoint = @Json.Serialize(selectedPoint);
    const editId = @Json.Serialize(ViewBag.EditId);
    const placeUrl = @Json.Serialize(Url.Action("Place", "Home"));
    const searchUrl = @Json.Serialize(Url.Action("SearchPlaces", "Home"));

    const map = L.map('map').setView([startLat, startLng], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text ?? '';
        return div.innerHTML;
    }

    // Markers for all stored resources, each with a small info box.
    const savedMarkers = savedResources.filter(r => r.id !== editId).map(function (r) {
        const savedMarker = L.marker([r.lat, r.lng], resourceMarkerOptions(r.type, false, map.getZoom())).addTo(map).bindPopup(
            '<div class="resource-popup"><strong>' + escapeHtml(r.name) + '</strong>' +
            'Type: ' + escapeHtml(r.type) + '<br>' +
            'Sted: ' + escapeHtml(r.location) + '<br>' +
            r.lat.toFixed(5) + ', ' + r.lng.toFixed(5) + '</div>'
        );
        return { resource: r, marker: savedMarker };
    });
    const controls = MapControls.add(map, {
        onTypeChange(type, visible) {
            savedMarkers.filter(item => item.resource.type === type).forEach(function (item) {
                if (visible) {
                    item.marker.setIcon(resourceMarkerOptions(type, false, map.getZoom()).icon);
                    item.marker.addTo(map);
                } else {
                    map.removeLayer(item.marker);
                }
            });
        }
    });

    // Marker for the location currently being chosen.
    const resourceType = document.getElementById('resourceType');
    let marker = null;

    resourceType.addEventListener('change', function () {
        if (!marker) return;
        const options = resourceMarkerOptions(resourceType.value, true, map.getZoom());
        marker.options.title = options.title;
        marker.options.alt = options.alt;
        marker.setIcon(options.icon);
    });

    map.on('zoomend', function () {
        savedMarkers.forEach(function (item) {
            item.marker.setIcon(resourceMarkerOptions(item.resource.type, false, map.getZoom()).icon);
        });
        if (marker) marker.setIcon(resourceMarkerOptions(resourceType.value, true, map.getZoom()).icon);
    });

    const focusId = new URLSearchParams(window.location.search).get('focus');
    const focused = savedMarkers.find(item => String(item.resource.id) === focusId);
    function focusResource(item) {
        controls.setTypeVisible(item.resource.type, true);
        map.setView(item.marker.getLatLng(), 15);
        item.marker.openPopup();
    }
    if (focused) focusResource(focused);

    const selectedPlace = document.getElementById('selectedPlace');
    let pointVersion = 0;
    let pointController = null;

    function showPlace(label) {
        selectedPlace.textContent = label;
    }

    function setLocation(lat, lng, label, resolvePlace = true) {
        const version = ++pointVersion;
        if (pointController) pointController.abort();
        const coordinates = lat.toFixed(5) + ', ' + lng.toFixed(5);
        map.setView([lat, lng], map.getZoom());
        if (!marker) {
            marker = L.marker([lat, lng], resourceMarkerOptions(resourceType.value, true, map.getZoom())).addTo(map);
        } else {
            marker.setLatLng([lat, lng]);
        }
        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;
        showPlace(label || coordinates);
        if (!resolvePlace || label) return;

        pointController = new AbortController();
        const controller = pointController;
        const timeout = setTimeout(() => controller.abort(), 6000);
        fetch(placeUrl + '?latitude=' + encodeURIComponent(lat) + '&longitude=' + encodeURIComponent(lng),
            { signal: controller.signal })
            .then(response => response.ok ? response.json() : null)
            .then(result => {
                if (version === pointVersion && !controller.signal.aborted && result?.label) showPlace(result.label);
            })
            .catch(() => { /* Coordinates remain usable when lookup is unavailable. */ })
            .finally(() => clearTimeout(timeout));
    }

    if (hasSelectedPoint) setLocation(startLat, startLng, selectedPlace.textContent, false);

    map.on('click', function (e) {
        setLocation(e.latlng.lat, e.latlng.lng);
    });

    document.querySelectorAll('.resource-card').forEach(function (card) {
        card.querySelector('.resource-focus').addEventListener('click', function () {
            const item = savedMarkers.find(item => String(item.resource.id) === card.dataset.resourceId);
            if (item) focusResource(item);
            else if (marker && editId === Number(card.dataset.resourceId)) {
                map.setView(marker.getLatLng(), 15);
            }
            document.getElementById('map').scrollIntoView({ behavior: 'smooth' });
        });
    });

    PlaceSearch.attach({
        input: document.getElementById('citySearch'),
        list: document.getElementById('citySuggestions'),
        status: document.getElementById('citySearchStatus'),
        button: document.getElementById('citySearchButton'),
        searchUrl,
        localitiesUrl: @Json.Serialize(FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/data/norway-localities.json"))),
        onSelect(place) {
            setLocation(place.lat, place.lng, place.label);
            map.setZoom(12);
        }
    });
</script>
