@model MapSubmissionViewModel
@using System.Globalization
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = "Kart";
    var isEditing = ViewBag.EditId != null;
    var registrationOpen = isEditing || !ViewData.ModelState.IsValid || Context.Request.Query["register"] == "true";
    var resources = (ViewBag.Resources as List<HeimevernetInnlevering1.Models.MapSubmission>) ?? new();
    var statusTime = DateTime.UtcNow;
    var resourceStatuses = ViewBag.ResourceStatuses as IReadOnlyDictionary<int, HeimevernetInnlevering1.Models.ResourceOperationalStatus>
        ?? resources.ToDictionary(r => r.Id, r => HeimevernetInnlevering1.Models.ResourceOperationalStatus.From(r, statusTime));
    var resourcesJson = System.Text.Json.JsonSerializer.Serialize(resources.Select(r => new
    {
        id = r.Id,
        name = r.ResourceName,
        type = r.ResourceType,
        location = r.LocationName,
        lat = r.Latitude,
        lng = r.Longitude,
        status = resourceStatuses[r.Id],
        updated = (r.UpdatedAtUtc ?? r.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture) + " UTC"
    }));
    var selectedPoint = Model?.Latitude is double lat && Model.Longitude is double lng
        && double.IsFinite(lat) && double.IsFinite(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180;
    var startLat = (selectedPoint ? Model!.Latitude!.Value : 58.1467).ToString(CultureInfo.InvariantCulture);
    var startLng = (selectedPoint ? Model!.Longitude!.Value : 7.9956).ToString(CultureInfo.InvariantCulture);
    var resourceIconUrls = new[] { "car", "excavator", "drone", "generator", "personnel", "toolbox", "unknown" }
        .SelectMany(file => new[] { file, file + "-available", file + "-unavailable" })
        .ToDictionary(file => file, file => FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content($"~/images/resources/{file}.svg")));
}
@functions {
    private static string AvailabilityLabel(HeimevernetInnlevering1.Models.ResourceAvailability availability) => availability switch
    {
        HeimevernetInnlevering1.Models.ResourceAvailability.Available => "Tilgjengelig",
        HeimevernetInnlevering1.Models.ResourceAvailability.Unavailable => "Utilgjengelig",
        HeimevernetInnlevering1.Models.ResourceAvailability.Reserved => "Reservert",
        HeimevernetInnlevering1.Models.ResourceAvailability.Allocated => "Tildelt",
        _ => "Ukjent"
    };
}

<link rel="stylesheet" href="~/css/workspace-map.css" asp-append-version="true" />
<section class="map-workspace" id="mapWorkspace" data-mobile-view="map" aria-labelledby="workspaceTitle">
    <div class="workspace-heading">
        <div><span class="eyebrow">RESSURSOVERSIKT</span><h1 id="workspaceTitle">Ressurskart</h1></div>
        <button type="button" id="registrationToggle" class="btn-secondary" aria-controls="registrationPanel" aria-expanded="@(registrationOpen ? "true" : "false")">@(isEditing ? "Rediger ressurs" : "Registrer ressurs")</button>
    </div>
    @if (TempData["MapSuccess"] is string success)
    {
        <p class="workspace-notice" role="status">@success</p>
    }
    <div class="workspace-mobile-switch" role="group" aria-label="Kartvisning">
        <button type="button" id="showMap" aria-pressed="true" aria-controls="mapRegion">Kart</button>
        <button type="button" id="showList" aria-pressed="false" aria-controls="resourceResults">Liste</button>
    </div>
    <div class="workspace-grid">
        <aside class="workspace-sidebar" aria-label="Søk og ressurser">
            <div class="workspace-search city-search-group">
                <label for="citySearch">Finn sted</label>
                <div class="workspace-search-row">
                    <div class="city-search-input">
                        <input type="text" id="citySearch" class="form-control" placeholder="By eller tettsted" autocomplete="off"
                               maxlength="120" role="combobox" aria-autocomplete="list" aria-expanded="false"
                               aria-controls="citySuggestions" aria-describedby="citySearchHelp citySearchStatus" />
                        <ul id="citySuggestions" class="city-suggestions" role="listbox" aria-label="Stedsforslag"></ul>
                    </div>
                    <button type="button" id="citySearchButton" class="btn-secondary">Søk</button>
                </div>
                <span id="citySearchStatus" role="status" aria-live="polite" aria-atomic="true"></span>
                <small id="citySearchHelp">Lokale forslag. Søk henter adresser eksternt.</small>
                <details class="workspace-disclosure">
                    <summary>Personvern og kartdata</summary>
                    <p>Lokale forslag dekker norske byer og tettsteder. Søk og punktvalg bruker OpenStreetMap; unngå fortrolige opplysninger. Kartfliser: OpenStreetMap.</p>
                    <p>Stedsdata: <a href="https://www.geonames.org/">GeoNames</a>, <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a> (utvalg og bearbeiding).</p>
                </details>
            </div>
            <section id="registrationPanel" class="registration-panel" hidden="@(!registrationOpen)" aria-labelledby="registrationTitle">
                <h2 id="registrationTitle">@(isEditing ? "Rediger ressurs" : "Registrer ressurs")</h2>
                <form method="post" asp-controller="Home" asp-action="@(isEditing ? "Edit" : "Map")" asp-route-id="@ViewBag.EditId" class="workspace-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <input type="hidden" asp-for="Version" />
                    <div class="form-group">
                        <label for="resourceName">Ressursnavn <span class="required">*</span></label>
                        <input type="text" id="resourceName" name="ResourceName" value="@Model?.ResourceName" class="form-control" placeholder="f.eks. Lastebil 1" minlength="2" maxlength="100" required />
                        <span asp-validation-for="ResourceName" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="resourceType">Ressurstype <span class="required">*</span></label>
                        <select id="resourceType" name="ResourceType" class="form-control" required>
                            <option value="">Velg type</option>
                            @foreach (var type in MapSubmissionViewModel.ResourceTypes)
                            {
                                <option value="@type" selected="@(Model?.ResourceType == type)">@type</option>
                            }
                        </select>
                        <span asp-validation-for="ResourceType" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label for="availability">Tilgjengelighet</label>
                        <select id="availability" asp-for="Availability" class="form-control">
                            <option value="Available">Tilgjengelig</option>
                            <option value="Unavailable">Utilgjengelig</option>
                            @if (Model?.Availability is HeimevernetInnlevering1.Models.ResourceAvailability.Reserved or HeimevernetInnlevering1.Models.ResourceAvailability.Allocated)
                            {
                                <option value="@Model.Availability">@AvailabilityLabel(Model.Availability) – styres av forespørsel</option>
                            }
                        </select>
                        <span asp-validation-for="Availability" class="text-danger"></span>
                    </div>
                    <details class="workspace-disclosure" open="@(!string.IsNullOrEmpty(Model?.Capability) || !string.IsNullOrEmpty(Model?.TransportRequirements))">
                        <summary>Kapasitet og transportbehov (valgfritt)</summary>
                        <div class="form-group">
                            <label for="capability">Kapasitet / bruksområde</label>
                            <textarea id="capability" asp-for="Capability" class="form-control" maxlength="500" rows="2" placeholder="f.eks. 5 kW, 8 seter eller løftekapasitet"></textarea>
                            <span asp-validation-for="Capability" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="transportRequirements">Transportbehov</label>
                            <textarea id="transportRequirements" asp-for="TransportRequirements" class="form-control" maxlength="500" rows="2" placeholder="f.eks. tilhenger eller kvalifisert fører"></textarea>
                            <span asp-validation-for="TransportRequirements" class="text-danger"></span>
                        </div>
                    </details>
                    <button type="button" id="placementToggle" class="btn-secondary" aria-pressed="@(registrationOpen ? "true" : "false")" aria-describedby="placementHelp">Velg plassering</button>
                    <p id="placementHelp">Klikk i kartet eller velg et sted. Slå av plassering for å utforske.</p>
                    <p id="selectedPlace" class="workspace-location" role="status">@(selectedPoint ? Model?.LocationName : "")</p>
                    <input type="hidden" id="latitude" name="Latitude" value="@(selectedPoint ? startLat : "")" />
                    <input type="hidden" id="longitude" name="Longitude" value="@(selectedPoint ? startLng : "")" />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                    <button type="submit" class="btn-submit">@(isEditing ? "Lagre endringer" : "Registrer ressurs")</button>
                </form>
            </section>
            <section id="resourceResults" class="workspace-results" aria-labelledby="resultsTitle">
                <h2 id="resultsTitle">Ressurser <span id="resourceCount">@resources.Count</span></h2>
                <label for="resourceFilter">Filtrer ressurstype</label>
                <select id="resourceFilter" class="form-control">
                    <option value="">Alle typer</option>
                    @foreach (var type in MapSubmissionViewModel.ResourceTypes)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
                <p id="resourceResultsStatus" class="workspace-muted" role="status">@(resources.Count == 0 ? "Ingen ressurser er registrert ennå." : "")</p>
                <div class="workspace-resource-list">
            @foreach (var r in resources)
            {
                var status = resourceStatuses[r.Id];
                <details class="resource-card" id="resource-@r.Id"
                     data-resource-id="@r.Id"
                     data-resource-type="@r.ResourceType"
                     data-lat="@r.Latitude.ToString(CultureInfo.InvariantCulture)"
                     data-lng="@r.Longitude.ToString(CultureInfo.InvariantCulture)">
                    <summary><img data-resource-icon="@r.ResourceType" data-resource-status="@System.Text.Json.JsonSerializer.Serialize(status)" alt="" width="32" height="32" /><span><strong>@r.ResourceName</strong><small>@r.ResourceType · @r.LocationName</small><small data-resource-status-text="@r.Id">@status.StatusText</small></span></summary>
                    <div class="resource-detail">
                        <dl>
                            <div><dt>Sist oppdatert</dt><dd>@((r.UpdatedAtUtc ?? r.CreatedAtUtc).ToString("dd.MM.yyyy HH:mm", CultureInfo.InvariantCulture)) UTC</dd></div>
                            <div><dt>Koordinater</dt><dd>@r.Latitude.ToString("F5", CultureInfo.InvariantCulture), @r.Longitude.ToString("F5", CultureInfo.InvariantCulture)</dd></div>
                            @if (!string.IsNullOrEmpty(r.Capability))
                            {
                                <div><dt>Kapasitet / bruksområde</dt><dd>@r.Capability</dd></div>
                            }
                            @if (!string.IsNullOrEmpty(r.TransportRequirements))
                            {
                                <div><dt>Transportbehov</dt><dd>@r.TransportRequirements</dd></div>
                            }
                        </dl>
                        <div class="resource-actions">
                            <button type="button" class="btn-secondary resource-focus">Vis på kart</button>
                            @if (HeimevernetInnlevering1.Models.ResourcePermissions.CanManage(User, r.OwnerId))
                            {
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn-secondary">Rediger</a>
                                <a asp-action="Delete" asp-route-id="@r.Id" class="btn-danger">Slett</a>
                            }
                        </div>
                    </div>
                </details>
            }
                </div>
            </section>
        </aside>
        <div class="workspace-map-region" id="mapRegion" aria-label="Ressurskart">
            <p id="mapModeStatus" role="status" class="workspace-map-status"></p>
            <div id="map" aria-label="Interaktivt kart over ressurser"></div>
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/map-controls.css" asp-append-version="true" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="~/js/resource-icons.js" asp-append-version="true" data-icon-base="@Url.Content("~/images/resources/")" data-icon-urls="@System.Text.Json.JsonSerializer.Serialize(resourceIconUrls)"></script>
<script src="~/js/map-controls.js" asp-append-version="true"></script>
<script src="~/js/place-search.js" asp-append-version="true"></script>
<script>
    const startLat = @startLat;
    const startLng = @startLng;
    const savedResources = @Html.Raw(resourcesJson);
    const hasSelectedPoint = @Json.Serialize(selectedPoint);
    const registrationInitiallyOpen = @Json.Serialize(registrationOpen);
    const editId = @Json.Serialize(ViewBag.EditId);
    const placeUrl = @Json.Serialize(Url.Action("Place", "Home"));
    const searchUrl = @Json.Serialize(Url.Action("SearchPlaces", "Home"));

    const map = L.map('map').setView([startLat, startLng], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    if (typeof ResizeObserver !== 'undefined') {
        const mapResizeObserver = new ResizeObserver(function (entries) {
            if (entries.some(entry => entry.contentRect.width > 0 && entry.contentRect.height > 0)) {
                map.invalidateSize?.({ pan: false });
            }
        });
        mapResizeObserver.observe(document.getElementById('map'));
    }

    const workspace = document.getElementById('mapWorkspace');
    const registrationPanel = document.getElementById('registrationPanel');
    const registrationToggle = document.getElementById('registrationToggle');
    const placementToggle = document.getElementById('placementToggle');
    const resourceFilter = document.getElementById('resourceFilter');
    const resourceCards = Array.from(document.querySelectorAll('.resource-card'));
    const visibleTypes = new Map();
    let placementActive = false;
    let pointVersion = 0;
    let pointController = null;
    registrationPanel.hidden = !registrationInitiallyOpen;

    function setMobileView(view) {
        workspace.dataset.mobileView = view;
        document.getElementById('showMap').setAttribute('aria-pressed', String(view === 'map'));
        document.getElementById('showList').setAttribute('aria-pressed', String(view === 'list'));
        if (view === 'map') map.invalidateSize?.({ pan: false });
    }
    document.getElementById('showMap').addEventListener('click', () => setMobileView('map'));
    document.getElementById('showList').addEventListener('click', () => setMobileView('list'));

    function setPlacement(active) {
        if (!active) cancelPointLookup();
        placementActive = active;
        placementToggle.setAttribute('aria-pressed', String(active));
        document.getElementById('mapModeStatus').textContent = active
            ? 'Plassering aktiv · klikk i kartet eller søk'
            : '';
        document.getElementById('map').classList[active ? 'add' : 'remove']('placement-active');
        if (active) setMobileView('map');
    }
    registrationToggle.addEventListener('click', function () {
        registrationPanel.hidden = !registrationPanel.hidden;
        registrationToggle.setAttribute('aria-expanded', String(!registrationPanel.hidden));
        setPlacement(!registrationPanel.hidden);
        if (!registrationPanel.hidden) document.getElementById('resourceName').focus();
    });
    placementToggle.addEventListener('click', () => setPlacement(!registrationPanel.hidden && !placementActive));

    function selectResource(id) {
        resourceCards.forEach(function (card) {
            card.open = String(id) === card.dataset.resourceId;
            if (card.open) card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text ?? '';
        return div.innerHTML;
    }

    function savedPopup(r) {
        return '<div class="resource-popup"><strong>' + escapeHtml(r.name) + '</strong>' +
            'Type: ' + escapeHtml(r.type) + '<br>' +
            'Sted: ' + escapeHtml(r.location) + '<br>' +
            'Operativ status: ' + escapeHtml(window.ResourceIcons.statusText(r.status)) + '<br>' +
            'Sist oppdatert: ' + escapeHtml(r.updated) + '<br>' +
            '<a href="#resource-' + r.id + '">Vis ressursdetaljer i listen</a><br>' +
            r.lat.toFixed(5) + ', ' + r.lng.toFixed(5) + '</div>';
    }

    // Markers for all stored resources, each with a small info box.
    const savedMarkers = savedResources.filter(r => r.id !== editId).map(function (r) {
        const savedMarker = L.marker([r.lat, r.lng], resourceMarkerOptions(r.type, false, map.getZoom(), r.status))
            .addTo(map).bindPopup(savedPopup(r));
        savedMarker.on('click', () => selectResource(r.id));
        return { resource: r, marker: savedMarker };
    });
    window.ResourceIcons.watchAvailability(function () {
        savedMarkers.forEach(function (item) {
            const options = resourceMarkerOptions(item.resource.type, false, map.getZoom(), item.resource.status);
            item.marker.options.title = options.title;
            item.marker.options.alt = options.alt;
            item.marker.setIcon(options.icon);
            const element = item.marker.getElement?.();
            if (element) {
                element.title = options.title;
                element.alt = options.alt;
            }
            item.marker.bindPopup(savedPopup(item.resource));
        });
    }, savedMarkers.map(item => item.resource.status));
    const controls = MapControls.add(map, {
        onTypeChange(type, visible) {
            visibleTypes.set(type, visible);
            savedMarkers.filter(item => item.resource.type === type).forEach(function (item) {
                if (visible) {
                    item.marker.setIcon(resourceMarkerOptions(type, false, map.getZoom(), item.resource.status).icon);
                    item.marker.addTo(map);
                } else {
                    map.removeLayer(item.marker);
                }
            });
            resourceCards.forEach(card => { card.hidden = visibleTypes.get(card.dataset.resourceType) === false; });
            const count = resourceCards.filter(card => !card.hidden).length;
            document.getElementById('resourceCount').textContent = count;
            document.getElementById('resourceResultsStatus').textContent = count
                ? count + ' ressurser vist' : 'Ingen ressurser passer filteret.';
        }
    });
    resourceFilter.addEventListener('change', function () {
        const types = new Set(savedResources.map(resource => resource.type));
        types.forEach(type => controls.setTypeVisible(type, !resourceFilter.value || resourceFilter.value === type));
    });

    // Marker for the location currently being chosen.
    const resourceType = document.getElementById('resourceType');
    let marker = null;

    resourceType.addEventListener('change', function () {
        if (!marker) return;
        const options = resourceMarkerOptions(resourceType.value, true, map.getZoom());
        marker.options.title = options.title;
        marker.options.alt = options.alt;
        marker.setIcon(options.icon);
    });

    map.on('zoomend', function () {
        savedMarkers.forEach(function (item) {
            item.marker.setIcon(resourceMarkerOptions(item.resource.type, false, map.getZoom(), item.resource.status).icon);
        });
        if (marker) marker.setIcon(resourceMarkerOptions(resourceType.value, true, map.getZoom()).icon);
    });

    const focusId = new URLSearchParams(window.location.search).get('focus');
    const focused = savedMarkers.find(item => String(item.resource.id) === focusId);
    function focusResource(item) {
        controls.setTypeVisible(item.resource.type, true);
        map.setView(item.marker.getLatLng(), 15);
        item.marker.openPopup();
        selectResource(item.resource.id);
        setMobileView('map');
    }
    if (focused) focusResource(focused);

    const selectedPlace = document.getElementById('selectedPlace');

    function cancelPointLookup() {
        pointVersion++;
        if (pointController) pointController.abort();
        pointController = null;
    }

    function showPlace(label) {
        selectedPlace.textContent = label;
        placeSearch.setValue(label);
    }

    function setLocation(lat, lng, label, resolvePlace = true) {
        cancelPointLookup();
        const version = pointVersion;
        const coordinates = lat.toFixed(5) + ', ' + lng.toFixed(5);
        map.setView([lat, lng], map.getZoom());
        if (!marker) {
            marker = L.marker([lat, lng], resourceMarkerOptions(resourceType.value, true, map.getZoom())).addTo(map);
        } else {
            marker.setLatLng([lat, lng]);
        }
        document.getElementById('latitude').value = lat;
        document.getElementById('longitude').value = lng;
        showPlace(label || coordinates);
        if (!resolvePlace || label) return;

        pointController = new AbortController();
        const controller = pointController;
        const timeout = setTimeout(() => controller.abort(), 6000);
        fetch(placeUrl + '?latitude=' + encodeURIComponent(lat) + '&longitude=' + encodeURIComponent(lng),
            { signal: controller.signal })
            .then(response => response.ok ? response.json() : null)
            .then(result => {
                if (version === pointVersion && !controller.signal.aborted
                    && typeof result?.label === 'string' && result.label.trim().length > 0
                    && result.label.length <= 220 && !/[\u0000-\u001f\u007f]/.test(result.label)) {
                    showPlace(result.label);
                }
            })
            .catch(() => { /* Coordinates remain usable when lookup is unavailable. */ })
            .finally(() => clearTimeout(timeout));
    }

    map.on('click', function (e) {
        if (placementActive) setLocation(e.latlng.lat, e.latlng.lng);
    });

    resourceCards.forEach(function (card) {
        card.addEventListener('toggle', function () {
            if (card.open) resourceCards.filter(other => other !== card).forEach(other => { other.open = false; });
        });
        card.querySelector('.resource-focus').addEventListener('click', function () {
            const item = savedMarkers.find(item => String(item.resource.id) === card.dataset.resourceId);
            if (item) focusResource(item);
            else if (marker && editId === Number(card.dataset.resourceId)) {
                map.setView(marker.getLatLng(), 15);
                setMobileView('map');
            }
            document.getElementById('map').scrollIntoView({ behavior: 'smooth' });
        });
    });

    const placeSearch = PlaceSearch.attach({
        input: document.getElementById('citySearch'),
        list: document.getElementById('citySuggestions'),
        status: document.getElementById('citySearchStatus'),
        button: document.getElementById('citySearchButton'),
        searchUrl,
        localitiesUrl: @Json.Serialize(FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/data/norway-localities.json"))),
        onInput: cancelPointLookup,
        onSelect(place) {
            if (placementActive) setLocation(place.lat, place.lng, place.label);
            map.setView([place.lat, place.lng], 12);
            setMobileView('map');
        }
    });
    setPlacement(registrationInitiallyOpen);
    if (hasSelectedPoint) setLocation(startLat, startLng, selectedPlace.textContent, false);
    document.getElementById('map').addEventListener('click', function (event) {
        const link = event.target.closest?.('a[href^="#resource-"]');
        if (link) {
            event.preventDefault();
            setMobileView('list');
            selectResource(link.getAttribute('href').slice('#resource-'.length));
        }
    });
</script>
