@using HeimevernetInnlevering1.Models
@{
    ViewData["Title"] = "Beredskap";
    var provider = User.IsInRole(AppRoles.Ressursleverandor);
    var dispatch = User.IsInRole(AppRoles.DispatchTeam);
    var leader = User.IsInRole(AppRoles.Kriseledelse);
    var publicActor = User.IsInRole(AppRoles.OffentligAktor);
    var roleTitle = provider ? "Ressursleverandør" : dispatch ? "Dispatch-team" : leader ? "Kriseledelse" : "Offentlig aktør";
    var roleAction = provider
        ? "Hold ressursopplysninger, mengde og tilgjengelighet oppdatert. Svar raskt på forespørsler fra dispatch."
        : dispatch
            ? "Verifiser nye ressurser, match dem mot behov og følg tildelinger hele veien til oppdraget er avsluttet."
            : leader
                ? "Prioriter behov, hold situasjonsbildet oppdatert og sørg for at ansvar og beslutninger er dokumentert."
                : "Meld inn behov med riktig sted og kontaktinformasjon. Følg opp statusen på Oversikt.";
}
<section class="operations-workspace preparedness-page" aria-labelledby="preparedness-heading">
    <div class="page-heading">
        <div><span class="eyebrow">RUTINER OG VARSLING</span><h1 id="preparedness-heading">Beredskap</h1></div>
        <a asp-action="Dashboard" class="btn-submit">Åpne oversikt</a>
    </div>

    <section class="preparedness-hero" aria-label="Din rolle">
        <span class="eyebrow">DIN ROLLE</span>
        <h2>@roleTitle</h2>
        <p>@roleAction</p>
    </section>

    <section class="preparedness-grid" aria-label="Beredskapsrutiner">
        <article>
            <h2>Ved akutt fare</h2>
            <p>Bruk offentlige nødnumre ved reell fare for liv, helse eller kritisk infrastruktur. Registrer deretter behovet i portalen slik at ressurskoordineringen får riktig sted og kontakt.</p>
            <div class="preparedness-numbers"><span><strong>110</strong> Brann</span><span><strong>112</strong> Politi</span><span><strong>113</strong> Ambulanse</span></div>
        </article>
        <article>
            <h2>Før innsats</h2>
            <ol>
                <li>Kontroller stedet, behovet og kontaktpersonen.</li>
                <li>Vurder tilgjengelige og verifiserte ressurser på kartet.</li>
                <li>Avklar ansvar før en ressurs tildeles eller sendes ut.</li>
            </ol>
        </article>
        <article>
            <h2>Etter innsats</h2>
            <ol>
                <li>Oppdater fremdriften til oppdraget er fullført.</li>
                <li>Registrer forbruk og returnerte ressurser.</li>
                <li>La dispatch verifisere ressursen før den brukes på nytt.</li>
            </ol>
        </article>
    </section>

    <section class="preparedness-note">
        <h2>Arbeidsflyt</h2>
        <p><strong>Oversikt</strong> inneholder oppgaver som må følges opp nå. <strong>Kart</strong> viser plassering og kapasitet. Denne siden samler rutinene som gjelder mellom hendelser, slik at den operative oversikten kan være kort og handlingsrettet.</p>
    </section>
</section>
