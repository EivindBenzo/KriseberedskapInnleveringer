@{
    ViewData["Title"] = "Hjem";
    var canUseOperations = User.Identity?.IsAuthenticated == true
        && !string.IsNullOrEmpty(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        && HeimevernetInnlevering1.Models.AppRoles.HasAny(User);
    var canRegister = User.IsInRole(HeimevernetInnlevering1.Models.AppRoles.Ressursleverandor);
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <span class="eyebrow">Oversikt starter med et sted</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <h1 id="home-title">Finn det som finnes.<br />Bidra med det du har.</h1>
                <p class="home-lead">Få oversikt over ressurser i området, eller sett din egen ressurs på kartet.</p>
                <div class="home-actions">
                    <a asp-action="Map" class="btn-submit">Finn ressurser i kartet <span aria-hidden="true">→</span></a>
                    @if (canRegister)
                    {
                        <a asp-action="Map" asp-route-register="true" class="btn-secondary">Registrer en ressurs</a>
                    }
                </div>
            }
            else
            {
                <h1 id="home-title">Et sted å samle<br />ressurser og bidrag.</h1>
                <p class="home-lead">Beredskapsportalen gir en felles oversikt over hva som finnes, hvor det er og om det er tilgjengelig.</p>
                <div class="home-actions">
                    <a asp-controller="Account" asp-action="Login" class="btn-submit">Logg inn <span aria-hidden="true">→</span></a>
                    <a asp-controller="Account" asp-action="Register" class="btn-secondary">Opprett brukerkonto</a>
                </div>
                <p class="home-context">Studentprosjekt · prototype. Ikke en offisiell tjeneste eller en kanal for reelle nødsituasjoner.</p>
            }
        </div>
        <img src="~/images/Heimevernet-background.jpg" asp-append-version="true"
             alt="Soldater i Heimevernet tar en pause sammen i grønne omgivelser."
             width="1024" height="707" class="home-photo" fetchpriority="high" />
    </section>

    <section class="home-guide" aria-labelledby="home-guide-title">
        <div class="home-guide-heading">
            <span class="eyebrow">OPERATIV ARBEIDSFLYT</span>
            <h2 id="home-guide-title">Fra registrering til innsats</h2>
            <p>Alle roller arbeider i samme flyt, med tydelig ansvar og oppdatert status.</p>
        </div>
        <ol class="home-steps">
            <li>
                <h3>Registrer behov eller ressurs</h3>
                <p>Offentlige aktører melder behov. Ressursleverandører legger inn tilgjengelig beholdning på kartet.</p>
            </li>
            <li>
                <h3>Dispatch koordinerer</h3>
                <p>Dispatch verifiserer ressursen, sender forespørsel til eieren og oppretter tildelingen når den er godtatt.</p>
            </li>
            <li>
                <h3>Følg leveransen</h3>
                <p>Kartet og Oversikt viser om ressursen er bekreftet, på vei, fremme eller fullført.</p>
                @if (canRegister)
                {
                    <a asp-action="Resources" asp-route-mine="true">Se mine ressurser <span aria-hidden="true">→</span></a>
                }
                @if (canUseOperations)
                {
                    <a asp-controller="Home" asp-action="Dashboard">@(canRegister ? "Svar på forespørsler til dine ressurser" : "Følg opp behov, forespørsler og tildeling") <span aria-hidden="true">→</span></a>
                }
            </li>
        </ol>
    </section>
</div>
