@{
    ViewData["Title"] = "Hjem";
}

<div class="hero hero-photo">
    <div class="hero-overlay"></div>

    <div class="hero-content hero-content-centered">
        <span class="eyebrow">HEIMEVERNET · INNLEVERING 1</span>
        <h1 class="hero-title-big">Heimevernet</h1>
    </div>
</div>

<section class="home-content home-intro">
    <span class="eyebrow">OVERSIKT</span>
    <h2>Alt samlet på ett sted</h2>
    <p>Åpne kartet for å registrere, finne og administrere ressurser.</p>

    <div class="feature-grid">
        <a asp-controller="Home" asp-action="Map" class="feature-card">
            <span class="feature-icon">&#8982;</span>
            <h3>Kart</h3>
            <p>Klikk i kartet for å velge og registrere koordinater.</p>
        </a>
    </div>
</section>
