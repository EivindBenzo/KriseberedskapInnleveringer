@model HeimevernetInnlevering1.Models.MapSubmission
@{
    ViewData["Title"] = "Slett ressurs";
}
<div class="form-container">
    <h1>Slett ressurs</h1>
    <p>Vil du slette «@Model.ResourceName» (@Model.ResourceType) ved @Model.LocationName? Dette kan ikke angres.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <input type="hidden" name="version" value="@Model.ConcurrencyToken" />
        <button type="submit" class="btn-danger">Ja, slett ressursen</button>
        <a asp-action="Map" class="btn-secondary">Avbryt</a>
    </form>
</div>
