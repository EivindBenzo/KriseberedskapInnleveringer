@model HeimevernetInnlevering1.Models.MapSubmission
@{
    ViewData["Title"] = "Slett ressurs";
}
<div class="form-container">
    <h1>Slett ressurs</h1>
    <p>Vil du slette «@Model.ResourceName» (@Model.ResourceType) ved @Model.LocationName? Dette kan ikke angres.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn-submit">Ja, slett ressursen</button>
        <a asp-action="Data" class="btn-secondary">Avbryt</a>
    </form>
</div>
