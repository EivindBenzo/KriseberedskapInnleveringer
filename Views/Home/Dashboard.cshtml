            <p class="dc-desc">@need.Beskrivelse</p>
            <div class="dc-foot"><span><strong>Antall: @need.Antall</strong></span><span>Registrert @Stamp(need.Registrert)@(need.Frist is DateTime frist ? " · frist " + Stamp(frist) : "")</span></div>
        </article>
