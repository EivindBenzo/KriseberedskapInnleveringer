@using HeimevernetInnlevering1.Models
@model HeimevernetInnlevering1.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Oversikt";
    var provider = User.IsInRole(AppRoles.Ressursleverandor);
    var dispatch = User.IsInRole(AppRoles.DispatchTeam);
    var leader = User.IsInRole(AppRoles.Kriseledelse);
    var publicActor = User.IsInRole(AppRoles.OffentligAktor);
    var actorId = ResourcePermissions.BrukerId(User);
    var roles = string.Join(" · ", AppRoles.All.Where(User.IsInRole).Select(AppRoles.Label));
    // Etter en handling sendes brukeren tilbake til samme element på siden (#anker), så siden ikke hopper til toppen.
    string Tilbake(string anker) => Url.Action("Dashboard", "Home") + "#" + anker;
    var now = DateTime.UtcNow;
    string PriorityChip(string p) => p == Statuser.Prioritet.Akutt ? "status-critical" : "";
    string ResourceChip(Ressurs r) => r.Status switch
    {
        Statuser.Ressurs.Tilgjengelig => "status-positive", Statuser.Ressurs.Avvist => "status-critical", _ => "status-warning"
    };
    string Stamp(DateTime value) => value.ToString("dd.MM.yyyy HH:mm") + " UTC";
    string Tittel(Behov b) => $"{b.Behovstype?.Navn} · {b.Stedsnavn}";
    string TypeIkon(string? n) { var t = (n ?? "").ToLowerInvariant(); return t.Contains("brann") ? "🔥" : t.Contains("flom") || t.Contains("vann") || t.Contains("nedbør") ? "🌊" : t.Contains("strøm") || t.Contains("generator") ? "⚡" : t.Contains("mannskap") || t.Contains("personell") ? "👥" : t.Contains("transport") || t.Contains("kjøretøy") ? "🚗" : t.Contains("søk") ? "🔍" : t.Contains("drone") ? "🛸" : t.Contains("maskin") ? "🚜" : t.Contains("mat") || t.Contains("nødhjelp") ? "🥫" : "📦"; }
    var providerAttention = Model.OwnResources.Count(r => r.Status is Statuser.Ressurs.VenterPåVerifisering or Statuser.Ressurs.Avvist);
    var pendingIncoming = Model.IncomingRequests.Count(f => f.Svar == Statuser.Svar.Venter);
    var pendingDispatch = Model.Requests.Count(f => f.Svar == Statuser.Svar.Venter) + Model.VerificationQueue.Count;
    var publicInProgress = Model.Needs.Count(n => n.Status is Statuser.Behov.Ny or Statuser.Behov.Vurderes);
    var displayName = Model.CurrentUserName;
    var nextStep = provider
        ? pendingIncoming > 0 ? "Svar på forespørslene som venter på ressursene dine." : "Kontroller at ressursene dine er klare til bruk."
        : dispatch
            ? Model.UrgentNeeds.Count > 0 ? "Start med de akutte behovene og finn en passende ressurs." : "Gå gjennom ressurser som venter på verifisering."
            : leader
                ? Model.UrgentNeeds.Count > 0 ? "Vurder de akutte behovene før ordinære oppgaver." : "Følg opp aktive hendelser og pågående tildelinger."
                : "Følg statusen på behovene dine og oppdater kontaktinformasjonen ved behov.";
}
<section class="operations-workspace dashboard" aria-labelledby="dashboard-heading">
<div class="page-heading">
    <div><span class="eyebrow">@roles</span><h1 id="dashboard-heading">Oversikt</h1></div>
    <a asp-action="Map" class="btn-secondary">Åpne kartet</a>
</div>
@if (TempData["WorkflowError"] is string error)
{
    <p class="workspace-alert" role="alert">@error</p>
}
@if (TempData["WorkflowSuccess"] is string success)
{
    <p class="notice" role="status">@success</p>
}
<section class="dashboard-action-grid" aria-label="Arbeidsoversikt">
@if (provider)
{
    <button type="button" class="dashboard-action dashboard-action-confirmed" data-dashboard-target="confirmed" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">▣</span><span><strong>Mine ressurser</strong><small>Beholdning, status og tilgjengelighet</small></span><span class="dashboard-action-count">@Model.OwnResources.Count</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-requests" data-dashboard-target="requests" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">↗</span><span><strong>Forespørsler til meg</strong><small>Ressurser som venter på ditt svar</small></span><span class="dashboard-action-count">@pendingIncoming</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-followup" data-dashboard-target="urgent" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">!</span><span><strong>Trenger oppfølging</strong><small>Venter på godkjenning eller må rettes</small></span><span class="dashboard-action-count">@providerAttention</span>
    </button>
}
else if (dispatch)
{
    <button type="button" class="dashboard-action dashboard-action-confirmed" data-dashboard-target="confirmed" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">✓</span><span><strong>Aktive tildelinger</strong><small>Oppdrag som er i gang</small></span><span class="dashboard-action-count">@Model.Assignments.Count</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-requests" data-dashboard-target="requests" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">↗</span><span><strong>Koordinering</strong><small>Behov, forespørsler og verifisering</small></span><span class="dashboard-action-count">@pendingDispatch</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-urgent" data-dashboard-target="urgent" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">!</span><span><strong>Akutte behov</strong><small>Må prioriteres nå</small></span><span class="dashboard-action-count">@Model.UrgentNeeds.Count</span>
    </button>
}
else if (leader)
{
    <button type="button" class="dashboard-action dashboard-action-confirmed" data-dashboard-target="confirmed" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">✓</span><span><strong>Aktive tildelinger</strong><small>Oppdrag under gjennomføring</small></span><span class="dashboard-action-count">@Model.Assignments.Count</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-requests" data-dashboard-target="requests" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">≡</span><span><strong>Situasjonsbilde</strong><small>Åpne behov og hendelser</small></span><span class="dashboard-action-count">@Model.Needs.Count</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-urgent" data-dashboard-target="urgent" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">!</span><span><strong>Akutte behov</strong><small>Krever lederbeslutning</small></span><span class="dashboard-action-count">@Model.UrgentNeeds.Count</span>
    </button>
}
else
{
    <button type="button" class="dashboard-action dashboard-action-confirmed" data-dashboard-target="confirmed" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">✓</span><span><strong>Mine behov</strong><small>Alle meldinger du har sendt</small></span><span class="dashboard-action-count">@Model.Needs.Count</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-requests" data-dashboard-target="requests" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">↗</span><span><strong>Under behandling</strong><small>Venter på vurdering eller ressurs</small></span><span class="dashboard-action-count">@publicInProgress</span>
    </button>
    <button type="button" class="dashboard-action dashboard-action-urgent" data-dashboard-target="urgent" aria-expanded="false">
        <span class="dashboard-action-icon" aria-hidden="true">!</span><span><strong>Akutte behov</strong><small>Meldinger med høyeste prioritet</small></span><span class="dashboard-action-count">@Model.UrgentNeeds.Count</span>
    </button>
}
</section>
<section id="dashboardIntro" class="dashboard-briefing" aria-label="Situasjonsbilde">
    <div class="dashboard-welcome">
        <span class="eyebrow">DIN BEREDSKAP</span>
        <h2>Hei, @displayName</h2>
        <p>@nextStep</p>
        <div class="dashboard-emergency">
            <span><strong>110</strong> Brann</span><span><strong>112</strong> Politi</span><span><strong>113</strong> Ambulanse</span>
        </div>
        <a asp-action="Map" class="btn-secondary">Se situasjonen på kartet</a>
        <a asp-controller="Messages" asp-action="Inbox" class="btn-secondary dashboard-message-link">
            <span>Meldinger</span>
            @if (Model.UnreadMessages.Count > 0)
            {
                <span class="unread-message-marker" aria-label="@Model.UnreadMessages.Count uleste meldinger">!</span>
            }
        </a>
    </div>
    <div class="dashboard-activity">
        <h2>Siste aktivitet</h2>
        @if (Model.RecentActivity.Count == 0)
        {
            <p class="resource-meta">Det er ingen ny aktivitet i dine arbeidsområder ennå.</p>
        }
        else
        {
            <ol>
            @foreach (var activity in Model.RecentActivity)
            {
                <li><strong>@activity.Label</strong><span>@activity.Actor · @Stamp(activity.OccurredAtUtc)</span></li>
            }
            </ol>
        }
    </div>
</section>

@if (provider)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="requests" hidden>
    <div class="dc-head"><h2 id="mine-foresporsler">Forespørsler til meg <span class="count-badge">@pendingIncoming</span></h2></div>
    @if (pendingIncoming == 0)
    {
        <p class="empty-state">Ingen forespørsler venter på ditt svar.</p>
    }
    <div class="dc-grid">
    @foreach (var request in Model.IncomingRequests.Where(f => f.Svar == Statuser.Svar.Venter))
    {
        var behov = request.Behov!;
        <article id="innkommende-@request.ForespørselID" class="dc-card dc-assign is-orange">
            <form asp-controller="Operations" asp-action="Respond" method="post" class="dc-verify">
                <input type="hidden" name="id" value="@request.ForespørselID" />
                <input type="hidden" name="returnUrl" value="@Tilbake("innkommende-" + request.ForespørselID)" />
                <div class="dc-top">
                    <i class="dc-ico" aria-hidden="true">@TypeIkon(behov.Behovstype?.Navn)</i>
                    <div class="dc-title"><strong>@request.Ressurs!.Navn</strong><span>📍 @Tittel(behov)</span></div>
                    <div class="dc-btns">
                        <button name="accept" value="true" type="submit" class="dc-primary">Godta</button>
                        <button name="accept" value="false" type="submit" class="dc-ghost">Avslå</button>
                    </div>
                </div>
                <div class="dc-chips"><span class="status-badge @PriorityChip(behov.Prioritet)">@Statuser.Visning(behov.Prioritet)</span>@if (behov.Frist is DateTime frist) { <span class="status-badge">Frist @Stamp(frist)</span> }</div>
                <p class="dc-desc">@behov.Beskrivelse</p>
                <input name="reason" maxlength="1000" class="dc-reason" placeholder="Kommentar (valgfritt)" aria-label="Kommentar" />
            </form>
            <button type="button" class="dc-ghost dc-histbtn" data-dc-toggle>Historikk</button>
            <div class="dc-more" hidden>@await Html.PartialAsync("_Timeline", Model.RequestTimeline.GetValueOrDefault(request.ForespørselID))</div>
        </article>
    }
    </div>

    @{ var besvarte = Model.IncomingRequests.Where(f => f.Svar != Statuser.Svar.Venter).ToList(); }
    <div class="dc-head dc-sub"><h2 id="besvarte-foresporsler">Fullførte og besvarte forespørsler <span class="count-badge">@besvarte.Count</span></h2></div>
    @if (besvarte.Count == 0)
    {
        <p class="empty-state">Ingen besvarte forespørsler ennå.</p>
    }
    <div class="dc-grid">
    @foreach (var request in besvarte)
    {
        var behov = request.Behov!;
        var ok = request.Svar == Statuser.Svar.Godtatt;
        <article id="innkommende-@request.ForespørselID" class="dc-card dc-assign dc-done @(ok ? "is-green" : "is-red")">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@(ok ? "✓" : "✕")</i>
                <div class="dc-title"><strong>@request.Ressurs!.Navn</strong><span>📍 @Tittel(behov)</span></div>
                <div class="dc-btns"><button type="button" class="dc-ghost" data-dc-toggle>Historikk</button></div>
            </div>
            <div class="dc-chips"><span class="status-badge @(ok ? "status-positive" : "status-critical")">✓ @Statuser.Visning(request.Svar)</span><span class="status-badge @PriorityChip(behov.Prioritet)">@Statuser.Visning(behov.Prioritet)</span></div>
            <p class="dc-desc">@behov.Beskrivelse</p>
            <div class="dc-more" hidden>@await Html.PartialAsync("_Timeline", Model.RequestTimeline.GetValueOrDefault(request.ForespørselID))</div>
        </article>
    }
    </div>
    </section>

    <section class="dashboard-panel dc-panel" data-dashboard-panel="confirmed" hidden>
    <div class="dc-head"><h2 id="mine-ressurser">Mine ressurser <span class="count-badge">@Model.OwnResources.Count</span></h2>
        <a asp-action="Map" asp-route-register="true" class="dc-primary dc-link-btn">Registrer ressurs</a></div>
    @if (Model.OwnResources.Count == 0)
    {
        <p class="empty-state">Du har ikke registrert noen ressurser ennå.</p>
    }
    <div class="dc-grid">
    @foreach (var resource in Model.OwnResources)
    {
        var status = ResourceOperationalStatus.From(resource, now);
        var sisteAvvisning = resource.Verifiseringer.OrderByDescending(v => v.Tidspunkt).FirstOrDefault();
        var rn = (resource.Ressurstype?.Navn ?? "").ToLowerInvariant();
        var rikon = rn.Contains("generator") ? "⚡" : rn.Contains("kjøretøy") ? "🚗" : rn.Contains("personell") ? "👥" : rn.Contains("drone") ? "🛸" : rn.Contains("maskin") ? "🚜" : "📦";
        <article id="min-ressurs-@resource.RessursID" class="dc-card dc-assign">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@rikon</i>
                <div class="dc-title"><strong>@resource.Navn</strong><span>📍 @resource.Ressurstype?.Navn · @resource.Stedsnavn</span></div>
                <div class="dc-btns">
                    @if (resource.Status is Statuser.Ressurs.Tilgjengelig or Statuser.Ressurs.Utilgjengelig)
                    {
                        var settTilgjengelig = resource.Status == Statuser.Ressurs.Utilgjengelig;
                        <button type="submit" form="av-@resource.RessursID" class="dc-primary">@(settTilgjengelig ? "Sett tilgjengelig" : "Sett utilgjengelig")</button>
                    }
                    @if (!Statuser.Ressurs.Opptatt.Contains(resource.Status))
                    {
                        <a asp-action="Edit" asp-route-id="@resource.RessursID" class="dc-ghost dc-link-btn">Rediger</a>
                    }
                    <button type="button" class="dc-ghost" data-dc-toggle>Historikk</button>
                </div>
            </div>
            <div class="dc-chips">
                <span class="status-badge @ResourceChip(resource)">@Statuser.Visning(resource.Status)</span>
                @if (status.Verification != status.Lifecycle)
                {
                    <span class="status-badge @(status.Verification == "Godkjent" ? "status-positive" : "status-warning")">@status.Verification</span>
                }
            </div>
            <div class="dc-foot"><span><strong>@resource.TilgjengeligAntall.ToString("0.##") @resource.Enhet</strong> av @resource.Antall.ToString("0.##")@(resource.ReservertAntall > 0 ? $" · {resource.ReservertAntall:0.##} reservert" : "")</span><span>@(resource.ErForbruksvare ? "Forbruksvare" : "Returneres")</span></div>
            @if (resource.Status == Statuser.Ressurs.VenterPåVerifisering)
            {
                <p class="dc-desc">Ressursen er ikke synlig for dispatch før den er verifisert.</p>
            }
            @if (resource.Status == Statuser.Ressurs.Avvist && sisteAvvisning?.Begrunnelse is string grunn)
            {
                <p class="dc-desc"><strong>Avvist:</strong> @grunn</p>
            }
            <form id="av-@resource.RessursID" asp-controller="Operations" asp-action="Availability" method="post" hidden>
                <input type="hidden" name="id" value="@resource.RessursID" />
                <input type="hidden" name="available" value="@(resource.Status == Statuser.Ressurs.Utilgjengelig ? "true" : "false")" />
                <input type="hidden" name="returnUrl" value="@Tilbake("min-ressurs-" + resource.RessursID)" />
            </form>
            <div class="dc-more" hidden>
                @await Html.PartialAsync("_Timeline", Model.ResourceTimeline.GetValueOrDefault(resource.RessursID))
            </div>
        </article>
    }
    </div>
    </section>
}

@if (provider)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="urgent" hidden>
    <div class="dc-head"><h2 id="ressurser-oppfolging">Ressurser som trenger oppfølging <span class="count-badge">@providerAttention</span></h2></div>
    @if (providerAttention == 0)
    {
        <p class="empty-state">Alle ressursene dine er enten klare eller har et aktivt oppdrag.</p>
    }
    <div class="dc-grid">
    @foreach (var resource in Model.OwnResources.Where(r => r.Status is Statuser.Ressurs.VenterPåVerifisering or Statuser.Ressurs.Avvist))
    {
        <article class="dc-card dc-assign @(resource.Status == Statuser.Ressurs.Avvist ? "is-red" : "is-orange")">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(resource.Ressurstype?.Navn)</i>
                <div class="dc-title"><strong>@resource.Navn</strong><span>📍 @resource.Ressurstype?.Navn · @resource.Stedsnavn</span></div>
                <div class="dc-btns"><a asp-action="Edit" asp-route-id="@resource.RessursID" class="dc-primary dc-link-btn">Åpne ressurs</a></div>
            </div>
            <div class="dc-chips"><span class="status-badge @(resource.Status == Statuser.Ressurs.Avvist ? "status-critical" : "status-warning")">@Statuser.Visning(resource.Status)</span></div>
            <p class="dc-desc">@(resource.Status == Statuser.Ressurs.VenterPåVerifisering
                ? "Dispatch må verifisere ressursen før den kan forespørres."
                : "Kontroller opplysningene og rediger ressursen før den sendes inn på nytt.")</p>
        </article>
    }
    </div>
    </section>
}

@if (dispatch)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="requests" hidden>
    <div class="dc-head"><h2 id="verifiseringskoe">Venter på verifisering <span class="count-badge">@Model.VerificationQueue.Count</span></h2>
</div>
    @if (Model.VerificationQueue.Count == 0)
    {
        <p class="empty-state">Ingen ressurser venter på verifisering.</p>
    }
    <div class="dc-grid">
    @foreach (var resource in Model.VerificationQueue)
    {
        <article id="verifisering-@resource.RessursID" class="dc-card is-orange">
            <form asp-controller="Operations" asp-action="Verify" method="post" class="dc-verify">
                <input type="hidden" name="id" value="@resource.RessursID" />
                <input type="hidden" name="returnUrl" value="@Tilbake("verifiseringskoe")" />
                <div class="dc-top">
                    <i class="dc-ico" aria-hidden="true">▣</i>
                    <div class="dc-title"><strong>@resource.Navn</strong><span>@(string.IsNullOrWhiteSpace(resource.Beskrivelse) ? resource.Ressurstype?.Navn + " · " + resource.Stedsnavn : resource.Beskrivelse)</span></div>
                    <div class="dc-btns dc-stack">
                        @if (resource.EierID != actorId) { <button name="approve" value="true" type="submit" class="dc-primary">Godkjenn</button> }
                        <button name="approve" value="false" type="submit" class="dc-ghost">Avvis</button>
                    </div>
                </div>
                <div class="dc-meta dc-col"><span>👤 Eier: @resource.Eier?.FulltNavn (@resource.Eier?.Organisasjon)</span><span>📞 @resource.Kontakttelefon</span><span>📅 Registrert: @Stamp(resource.Registrert)</span></div>
                <input name="reason" maxlength="1000" class="dc-reason" placeholder="Begrunnelse (kreves ved avvisning)" aria-label="Begrunnelse" />
            </form>
        </article>
    }
    </div>
    </section>
}

@if (dispatch)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="requests" hidden>
    <div class="dc-head"><h2 id="apne-behov">Åpne behov <span class="count-badge">@Model.OpenNeeds.Count</span></h2></div>
    @if (Model.OpenNeeds.Count == 0)
    {
        <p class="empty-state">Ingen åpne behov.</p>
    }
    <div class="dc-grid">
    @foreach (var need in Model.OpenNeeds)
    {
        var passendeTyper = need.Behovstype?.PassendeRessurstyper.Select(k => k.RessurstypeID).ToHashSet() ?? [];
        var matches = Model.MatchingResources
            .Where(r => passendeTyper.Contains(r.RessurstypeID))
            .OrderByDescending(r => string.Equals(ResourceCity.FromLocation(r.Stedsnavn), ResourceCity.FromLocation(need.Stedsnavn), StringComparison.OrdinalIgnoreCase))
            .ToList();
        <article id="behov-@need.BehovID" class="dc-card dc-assign is-orange">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(need.Behovstype?.Navn)</i>
                <div class="dc-title"><strong>@need.Behovstype?.Navn</strong><span>📍 @need.Stedsnavn</span></div>
                <div class="dc-btns">
                    @if (need.Status is Statuser.Behov.Ny or Statuser.Behov.Vurderes)
                    {
                        <button type="button" class="dc-primary" data-dc-toggle>Tildel ressurs (@matches.Count)</button>
                    }
                </div>
            </div>
            <div class="dc-chips"><span class="status-badge @PriorityChip(need.Prioritet)">@Statuser.Visning(need.Prioritet)</span><span class="status-badge">@Statuser.Visning(need.Status)</span></div>
            <p class="dc-desc">@need.Beskrivelse</p>
            <div class="dc-meta dc-col"><span>👤 @need.Kontaktperson · 📞 @need.Kontakttelefon</span><span>Antall: @need.Antall@(need.Frist is DateTime frist ? " · frist " + Stamp(frist) : "")@(need.Hendelse is Hendelse h ? " · " + h.Navn : "")</span></div>
            <div class="dc-more" hidden>
                @if (matches.Count == 0)
                {
                    <p class="empty-state">Ingen tilgjengelige ressurser av riktig type.</p>
                }
                @foreach (var resource in matches)
                {
                    <form asp-controller="Operations" asp-action="CreateRequest" method="post" class="inline-form">
                        <input type="hidden" name="needId" value="@need.BehovID" />
                        <input type="hidden" name="resourceId" value="@resource.RessursID" />
                        <input type="hidden" name="returnUrl" value="@Tilbake("behov-" + need.BehovID)" />
                        <span><strong>@resource.Navn</strong> · @resource.Ressurstype?.Navn · @resource.TilgjengeligAntall.ToString("0.##") @resource.Enhet tilgjengelig</span>
                        @{ var maksAntall = Math.Min(need.Mangler, resource.TilgjengeligAntall).ToString(System.Globalization.CultureInfo.InvariantCulture); }<label>Antall <input type="number" name="quantity" min="0.01" max="@maksAntall" step="0.01" value="@maksAntall" required /></label>
                        <button type="submit" class="dc-primary">Send forespørsel</button>
                    </form>
                }
            </div>
        </article>
    }
    </div>

    <div class="dc-head"><h2 id="foresporsler">Forespørsler <span class="count-badge">@Model.Requests.Count</span></h2></div>
    @if (Model.Requests.Count == 0)
    {
        <p class="empty-state">Ingen forespørsler venter på svar eller tildeling.</p>
    }
    <div class="dc-grid">
    @foreach (var request in Model.Requests)
    {
        <article id="foresporsel-@request.ForespørselID" class="dc-card dc-assign @(request.Svar == Statuser.Svar.Venter ? "is-orange" : "is-green")">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(request.Ressurs!.Ressurstype?.Navn)</i>
                <div class="dc-title"><strong>@request.Ressurs!.Navn</strong><span>📍 → @request.Behov!.Stedsnavn</span></div>
                <div class="dc-btns">
                    @if (request.Svar == Statuser.Svar.Godtatt)
                    {
                        <button type="submit" form="al-@request.ForespørselID" class="dc-primary">Opprett tildeling</button>
                    }
                    <button type="button" class="dc-ghost" data-dc-toggle>Detaljer</button>
                </div>
            </div>
            <div class="dc-chips"><span class="status-badge @(request.Svar == Statuser.Svar.Venter ? "status-warning" : "status-positive")">@Statuser.Visning(request.Svar)</span></div>
            <div class="dc-foot"><span><strong>@request.Antall.ToString("0.##") @request.Ressurs!.Enhet</strong></span><span>Sendt @Stamp(request.Sendt)</span></div>
            @if (request.Svar == Statuser.Svar.Godtatt)
            {
                <form id="al-@request.ForespørselID" asp-controller="Operations" asp-action="Allocate" method="post" hidden>
                    <input type="hidden" name="id" value="@request.ForespørselID" />
                    <input type="hidden" name="returnUrl" value="@Tilbake("foresporsel-" + request.ForespørselID)" />
                </form>
            }
            <div class="dc-more" hidden>
                <form asp-controller="Operations" asp-action="Cancel" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@request.ForespørselID" />
                    <input type="hidden" name="returnUrl" value="@Tilbake("foresporsel-" + request.ForespørselID)" />
                    <label>Avbryt forespørsel – begrunnelse <input name="reason" required maxlength="1000" /></label>
                    <button type="submit" class="dc-ghost">Avbryt</button>
                </form>
                @await Html.PartialAsync("_Timeline", Model.RequestTimeline.GetValueOrDefault(request.ForespørselID))
            </div>
        </article>
    }
    </div>
    </section>
}

@if (dispatch)
{
    <section class="dashboard-panel dashboard-urgent-panel dc-panel" data-dashboard-panel="urgent" hidden>
    <div class="dc-head"><h2 id="akutte-behov">Akutte behov <span class="count-badge">@Model.UrgentNeeds.Count</span></h2>
</div>
    @if (Model.UrgentNeeds.Count == 0)
    {
        <p class="empty-state">Ingen akutte behov akkurat nå.</p>
    }
    <div class="dc-grid">
    @foreach (var need in Model.UrgentNeeds)
    {
        var passendeTyper = need.Behovstype?.PassendeRessurstyper.Select(k => k.RessurstypeID).ToHashSet() ?? [];
        var passende = Model.MatchingResources.Where(r => passendeTyper.Contains(r.RessurstypeID)).ToList();
        var mangler = need.Mangler;
        <article id="behov-@need.BehovID" class="dc-card is-red">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">!</i>
                <div class="dc-title"><strong>@need.Behovstype?.Navn</strong><span>@need.Stedsnavn</span></div>
                <span class="dc-pill">Akutt</span>
                <div class="dc-qty"><b>@mangler.ToString("0.##")</b><small>mangler av @need.Antall</small></div>
            </div>
            <p class="dc-desc">@need.Beskrivelse</p>
            <div class="dc-meta"><span>👤 @need.Kontaktperson</span><span>📞 @need.Kontakttelefon</span>@if (need.Frist is DateTime frist) { <span>⏱ frist @Stamp(frist)</span> }</div>
            <div class="dc-actions">
                <button type="button" class="dc-primary" data-dc-toggle>Tildel ressurs (@passende.Count)</button>
            </div>
            <div class="dc-more" hidden>
                @if (passende.Count == 0)
                {
                    <p class="empty-state">Ingen tilgjengelige ressurser av typen @need.Behovstype?.Navn.</p>
                }
                @foreach (var resource in passende)
                {
                    var maks = Math.Min(mangler, resource.TilgjengeligAntall);
                    <form asp-controller="Operations" asp-action="CreateRequest" method="post" class="inline-form">
                        <input type="hidden" name="needId" value="@need.BehovID" />
                        <input type="hidden" name="resourceId" value="@resource.RessursID" />
                        <input type="hidden" name="returnUrl" value="@Tilbake("behov-" + need.BehovID)" />
                        <span><strong>@resource.Navn</strong> · @resource.TilgjengeligAntall.ToString("0.##") @resource.Enhet tilgjengelig</span>
                        <label>Antall <input type="number" name="quantity" min="0.01" max="@maks.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@maks.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                        <button type="submit" class="dc-primary">Send forespørsel</button>
                    </form>
                }
            </div>
        </article>
    }
    </div>
    </section>
}

@if (dispatch || leader)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="confirmed" hidden>
    <div class="dc-head"><h2 id="tildelinger">Aktive tildelinger <span class="count-badge">@Model.Assignments.Count</span></h2>
        </div>
    @if (Model.Assignments.Count == 0)
    {
        <p class="empty-state">Ingen aktive tildelinger.</p>
    }
    <div class="dc-grid">
    @foreach (var assignment in Model.Assignments)
    {
        var steg = Array.IndexOf(Statuser.Fremdrift.Rekkefølge, assignment.Fremdrift);
        var next = WorkflowTransitions.NextAssignmentStep(assignment.Fremdrift);
        var res = assignment.Forespørsel!.Ressurs!;
        var tn = (res.Ressurstype?.Navn ?? "").ToLowerInvariant();
        var ikon = tn.Contains("generator") ? "⚡" : tn.Contains("kjøretøy") ? "🚗" : tn.Contains("personell") ? "👥" : tn.Contains("drone") ? "🛸" : tn.Contains("maskin") ? "🚜" : "📦";
        <article id="tildeling-@assignment.TildelingID" class="dc-card dc-assign">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@ikon</i>
                <div class="dc-title"><strong>@res.Navn</strong><span>📍 @assignment.Forespørsel.Behov!.Stedsnavn</span></div>
                <div class="dc-btns">
                    @if (dispatch && next is not null) { <button type="submit" form="tf-@assignment.TildelingID" class="dc-primary">Sett til @next.ToLowerInvariant()</button> }
                    <button type="button" class="dc-ghost" data-dc-toggle>Detaljer</button>
                </div>
            </div>
            <ol class="dc-steps" aria-label="Fremdrift">
                @for (var i = 0; i < Statuser.Fremdrift.Rekkefølge.Length; i++)
                {
                    <li class="@(i < steg ? "is-done" : i == steg ? "is-now" : "")"><b>@(i < steg ? "✓" : "")</b><span>@Statuser.Visning(Statuser.Fremdrift.Rekkefølge[i])</span></li>
                }
            </ol>
            <div class="dc-foot"><span>👤 @(res.Kontaktperson ?? res.Eier?.FulltNavn)</span><span>📞 @res.Kontakttelefon</span></div>
            <div class="dc-more" hidden>
            @if (dispatch && next is not null)
            {
                <form id="tf-@assignment.TildelingID" asp-controller="Operations" asp-action="Assignment" method="post" class="inline-form">
                    <input type="hidden" name="id" value="@assignment.TildelingID" />
                    <input type="hidden" name="status" value="@next" />
                    <input type="hidden" name="returnUrl" value="@Tilbake("tildeling-" + assignment.TildelingID)" />
                    <label>Forventet fremme <input type="datetime-local" name="expectedArrival" value="@assignment.ForventetFremme?.ToString("yyyy-MM-ddTHH:mm")" /></label>
                    <label>Mottakskontakt <input name="receivingContact" maxlength="150" value="@assignment.Mottakskontakt" /></label>
                    @if (next == Statuser.Fremdrift.Fullført)
                    {
                        <label>Levert antall <input type="number" name="deliveredQuantity" min="0.01" max="@assignment.Forespørsel.Antall.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@assignment.Forespørsel.Antall.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                        <label>Avvik (valgfritt) <input name="deviation" maxlength="1000" /></label>
                    }
                    <label>Kommentar (valgfritt) <input name="reason" maxlength="1000" /></label>
                </form>
            }
            @await Html.PartialAsync("_Timeline", Model.AssignmentTimeline.GetValueOrDefault(assignment.TildelingID))
            </div>
        </article>
    }
    </div>
    </section>
}

@if (leader)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="requests" hidden>
    <div class="dc-head"><h2 id="dispatch-koe">Dispatch-kø <span class="count-badge">@Model.DispatchQueue.Count</span></h2>
        <a asp-controller="Home" asp-action="Dashboard" class="dc-ghost dc-link-btn">Åpne operasjoner</a></div>
    @if (Model.DispatchQueue.Count == 0)
    {
        <p class="empty-state">Ingen oppgaver krever handling akkurat nå.</p>
    }
    <div class="dc-grid">
    @foreach (var item in Model.DispatchQueue)
    {
        <a href="@item.Target" class="dc-card dc-assign @(item.Priority == 1 ? "is-red" : "is-orange") dc-linkcard">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@(item.Priority == 1 ? "🚨" : "📋")</i>
                <div class="dc-title"><strong>@item.Title</strong><span>@item.Category</span></div>
            </div>
            <p class="dc-desc">@item.Details</p>
        </a>
    }
    </div>
    </section>

    <section class="dashboard-panel dc-panel" data-dashboard-panel="confirmed" hidden>
    <div class="dc-head"><h2 id="situasjonsbilde">Situasjonsbilde</h2>
        <a asp-controller="Home" asp-action="Dashboard" class="dc-ghost dc-link-btn">Åpne styring</a></div>
    <div class="dashboard-stats">
        <div><strong>@Model.ActiveIncidents.Count</strong><span>aktive hendelser</span></div>
        <div><strong>@Model.OpenNeeds.Count</strong><span>ordinære behov</span></div>
        <div><strong>@Model.Requests.Count(f => f.Svar == Statuser.Svar.Venter)</strong><span>venter på svar</span></div>
        <div><strong>@Model.Assignments.Count</strong><span>aktive tildelinger</span></div>
    </div>
    <div class="dc-head"><h2 id="hendelser">Aktive hendelser <span class="count-badge">@Model.ActiveIncidents.Count</span></h2>
        <a asp-controller="Hendelse" asp-action="Index" class="dc-ghost dc-link-btn">Opprett og avslutt hendelser</a></div>
    @if (Model.ActiveIncidents.Count == 0)
    {
        <p class="empty-state">Ingen aktive hendelser.</p>
    }
    <div class="dc-grid">
    @foreach (var hendelse in Model.ActiveIncidents)
    {
        <article class="dc-card dc-assign">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(hendelse.Navn)</i>
                <div class="dc-title"><strong>@hendelse.Navn</strong><span>📍 @hendelse.Område</span></div>
            </div>
            <div class="dc-chips"><span class="status-badge status-warning">Aktiv hendelse</span></div>
            <p class="dc-desc">@hendelse.Beskrivelse</p>
            <div class="dc-foot"><span>Startet @Stamp(hendelse.Starttidspunkt)</span></div>
        </article>
    }
    </div>
    </section>

    <section class="dashboard-panel dc-panel" data-dashboard-panel="urgent" hidden>
    <div class="dc-head"><h2 id="behov-prioritet">Akutte behov <span class="count-badge">@Model.UrgentNeeds.Count</span></h2>
        <a asp-controller="Home" asp-action="Dashboard" class="dc-ghost dc-link-btn">Prioriter og endre status</a></div>
    @if (Model.UrgentNeeds.Count == 0)
    {
        <p class="empty-state">Ingen akutte behov akkurat nå.</p>
    }
    <div class="dc-grid">
    @foreach (var need in Model.UrgentNeeds)
    {
        <article class="dc-card dc-assign is-red">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(need.Behovstype?.Navn)</i>
                <div class="dc-title"><strong>@need.Behovstype?.Navn</strong><span>📍 @need.Stedsnavn</span></div>
            </div>
            <div class="dc-chips"><span class="status-badge status-critical">Akutt</span><span class="status-badge">@Statuser.Visning(need.Status)</span></div>
            <p class="dc-desc">@need.Beskrivelse</p>
            <div class="dc-foot"><span><strong>Antall: @need.Antall</strong></span><span>Registrert @Stamp(need.Registrert)@(need.Hendelse is Hendelse h ? " · " + h.Navn : "")</span></div>
        </article>
    }
    </div>
    <div class="dc-head"><h2 id="brukere">Brukere og roller</h2>
        <a asp-controller="Admin" asp-action="Index" class="dc-ghost dc-link-btn">Administrer brukere</a></div>
    <div class="dc-chips">
        @foreach (var (role, count) in Model.RoleCounts)
        {
            <span class="status-badge">@AppRoles.Label(role): @count</span>
        }
    </div>
    </section>
}

@if (publicActor)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="confirmed" hidden>
    <div class="dc-head"><h2 id="mine-behov">Mine behov <span class="count-badge">@Model.Needs.Count</span></h2>
        <a asp-controller="Behov" asp-action="Registrer" class="dc-primary dc-link-btn">Meld nytt behov</a></div>
    @if (Model.Needs.Count == 0)
    {
        <p class="empty-state">Du har ikke meldt inn noen behov.</p>
    }
    <div class="dc-grid">
    @foreach (var need in Model.Needs)
    {
        <article class="dc-card dc-assign">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(need.Behovstype?.Navn)</i>
                <div class="dc-title"><strong>@need.Behovstype?.Navn</strong><span>📍 @need.Stedsnavn</span></div>
            </div>
            <div class="dc-chips"><span class="status-badge @PriorityChip(need.Prioritet)">@Statuser.Visning(need.Prioritet)</span><span class="status-badge">@Statuser.Visning(need.Status)</span></div>
            <p class="dc-desc">@need.Beskrivelse</p>
            <div class="dc-foot"><span><strong>Antall: @need.Antall</strong></span><span>Registrert @Stamp(need.Registrert)@(need.Frist is DateTime frist ? " · frist " + Stamp(frist) : "")</span></div>
        </article>
    }
    </div>
    </section>

