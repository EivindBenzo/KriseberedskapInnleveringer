    @foreach (var need in Model.UrgentNeeds)
    {
        <article id="mine-akutt-@need.BehovID" class="dc-card dc-assign is-red">
            <div class="dc-top">
                <i class="dc-ico" aria-hidden="true">@TypeIkon(need.Behovstype?.Navn)</i>
                <div class="dc-title"><strong>@need.Behovstype?.Navn</strong><span>📍 @need.Stedsnavn</span></div>
            </div>
            <div class="dc-chips"><span class="status-badge status-critical">Akutt</span><span class="status-badge">@Statuser.Visning(need.Status)</span></div>
            <p class="dc-desc">@need.Beskrivelse</p>
            <div class="dc-foot"><span><strong>Antall: @need.Antall</strong></span><span>Registrert @Stamp(need.Registrert)@(need.Frist is DateTime frist ? " · frist " + Stamp(frist) : "")</span></div>
        </article>
    }
    </div>
    </section>
}
</section>
@if (Model.UnreadMessages.Count > 0)
{
    <dialog id="unreadMessages" class="unread-message-dialog" data-unread-message-ids="@string.Join(",", Model.UnreadMessages.Select(message => message.Id))" aria-labelledby="unreadMessagesHeading">
        <div class="message-composer-heading">
            <div><span class="eyebrow">NYE MELDINGER</span><h2 id="unreadMessagesHeading">@Model.UnreadMessages.Count uleste meldinger</h2></div>
            <button type="button" class="message-close" data-close-unread aria-label="Lukk">×</button>
        </div>
        <ol>
        @foreach (var message in Model.UnreadMessages)
        {
            <li><strong>@message.Subject</strong><span>Fra @message.SenderName</span></li>
        }
        </ol>
        <a asp-controller="Messages" asp-action="Inbox" class="btn-submit">Åpne meldinger</a>
    </dialog>
}
<script src="~/js/dashboard-workspace.js" asp-append-version="true"></script>
<script src="~/js/messages.js" asp-append-version="true"></script>
