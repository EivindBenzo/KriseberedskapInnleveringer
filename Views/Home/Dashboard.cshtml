    }
    </div>
    </section>
}

@if (dispatch || leader)
{
    <section class="dashboard-panel dc-panel" data-dashboard-panel="confirmed" hidden>
    <div class="dc-head"><h2 id="tildelinger">Aktive tildelinger <span class="count-badge">@Model.Assignments.Count</span></h2>
        </div>
    @if (Model.Assignments.Count == 0)
    {
        <p class="empty-state">Ingen aktive tildelinger.</p>
    }
    <div class="dc-grid">
    @foreach (var assignment in Model.Assignments)
    {
        var steg = Array.IndexOf(Statuser.Fremdrift.Rekkefølge, assignment.Fremdrift);
        var next = WorkflowTransitions.NextAssignmentStep(assignment.Fremdrift);
        var res = assignment.Forespørsel!.Ressurs!;
        var tn = (res.Ressurstype?.Navn ?? "").ToLowerInvariant();
        var ikon = tn.Contains("generator") ? "⚡" : tn.Contains("kjøretøy") ? "🚗" : tn.Contains("personell") ? "👥" : tn.Contains("drone") ? "🛸" : tn.Contains("maskin") ? "🚜" : "📦";
        var handling = next switch { Statuser.Fremdrift.PåVei => "Registrer avgang", Statuser.Fremdrift.Fremme => "Registrer ankomst", Statuser.Fremdrift.Fullført => "Bekreft levering", _ => "" };
        var antallTekst = assignment.Forespørsel.Antall.ToString("0.##") + " " + res.Enhet;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        <article id="tildeling-@assignment.TildelingID" class="dc-card dc-assign dc-act ta-card ta-s@(steg)">
            <aside class="ta-side" style="--p:@((steg + 1) * 25)">
                <div class="ta-ring"><div class="ta-ring-in">
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(steg == 0 ? "<rect x='8' y='2' width='8' height='4' rx='1'/><path d='M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2'/>" : steg == 1 ? "<path d='M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2'/><path d='M15 18H9'/><path d='M19 18h2a1 1 0 0 0 1-1v-3.7a1 1 0 0 0-.2-.6l-3.4-4.3a1 1 0 0 0-.8-.4H14'/><circle cx='17' cy='18' r='2'/><circle cx='7' cy='18' r='2'/>" : steg == 2 ? "<path d='M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z'/><circle cx='12' cy='10' r='3'/>" : "<path d='M20 6 9 17l-5-5'/>")</svg>
                    <strong>@Statuser.Visning(assignment.Fremdrift)</strong>
                    <small>@(steg + 1) av 4 steg</small>
                </div></div>
            </aside>
            <div class="ta-body">
            <div class="dc-top">
                <i class="dc-ico dc-ico-svg" aria-hidden="true">@Html.Raw(ResIkon(tn))</i>
                <div class="dc-title"><strong>@res.Navn</strong><span>📍 @assignment.Forespørsel.Behov!.Stedsnavn</span></div>
            </div>
            <ol class="dc-steps" aria-label="Fremdrift">
                @for (var i = 0; i < Statuser.Fremdrift.Rekkefølge.Length; i++)
                {
                    <li class="@(i < steg ? "is-done" : i == steg ? "is-now" : "")"><b>@if (i < steg) { <text>✓</text> } else if (i == steg) { @Html.Raw(StegIkon(i)) }</b><span>@Statuser.Visning(Statuser.Fremdrift.Rekkefølge[i])</span></li>
                }
            </ol>
            <div class="dc-foot dc-facts">
                <span title="Tildelt antall">📦 @antallTekst</span>
                <span title="Forventet fremme">🕒 @(assignment.ForventetFremme is DateTime eta ? Stamp(eta) : "Ikke satt")</span>
                <span title="Mottakskontakt">👤 @(string.IsNullOrWhiteSpace(assignment.Mottakskontakt) ? (res.Kontaktperson ?? res.Eier?.FulltNavn) : assignment.Mottakskontakt)</span>
            </div>
            <div class="dc-actions">
                <button type="button" class="dc-ghost" data-dc-toggle>Detaljer</button>
                @if (dispatch && next is not null) { <button type="button" class="dc-primary" data-dc-dialog="dlg-@assignment.TildelingID">@handling</button> }
            </div>
            @if (dispatch && next is not null)
            {
                <dialog id="dlg-@assignment.TildelingID" class="dc-dialog">
                <form id="tf-@assignment.TildelingID" asp-controller="Operations" asp-action="Assignment" method="post" class="inline-form dc-dialog-form">
                    <input type="hidden" name="id" value="@assignment.TildelingID" />
                    <input type="hidden" name="status" value="@next" />
                    <input type="hidden" name="returnUrl" value="@Tilbake("tildeling-" + assignment.TildelingID)" />
                    <label>Forventet fremme <input type="datetime-local" name="expectedArrival" value="@assignment.ForventetFremme?.ToString("yyyy-MM-ddTHH:mm")" /></label>
                    <label>Mottakskontakt <input name="receivingContact" maxlength="150" value="@assignment.Mottakskontakt" /></label>
                    @if (next == Statuser.Fremdrift.Fullført)
                    {
                        <label>Levert antall <input type="number" name="deliveredQuantity" min="0.01" max="@assignment.Forespørsel.Antall.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="@assignment.Forespørsel.Antall.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
                        <label>Avvik (valgfritt) <input name="deviation" maxlength="1000" /></label>
                    }
                    <label>Kommentar (valgfritt) <input name="reason" maxlength="1000" /></label>
                    <div class="dc-dialog-btns">
                        <button type="button" class="dc-ghost" data-dc-close>Avbryt</button>
                        <button type="submit" class="dc-primary">@handling</button>
                    </div>
                </form>
                </dialog>
            }
            <div class="dc-more" hidden>
                <dl class="dc-qty">
                    <div><dt>Forespurt</dt><dd>@assignment.Forespørsel.Antall.ToString("0.##") @res.Enhet</dd></div>
                    <div><dt>Levert</dt><dd>@((assignment.LevertAntall ?? 0).ToString("0.##")) @res.Enhet</dd></div>
                    <div><dt>Behov totalt</dt><dd>@assignment.Forespørsel.Behov!.Levert.ToString("0.##") / @assignment.Forespørsel.Behov.Antall.ToString("0.##")</dd></div>
                </dl>
                @await Html.PartialAsync("_Timeline", Model.AssignmentTimeline.GetValueOrDefault(assignment.TildelingID))
            </div>
        </div>
        </article>
    }
    </div>
    </section>
}

