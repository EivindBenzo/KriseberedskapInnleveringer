@model IReadOnlyList<HeimevernetInnlevering1.Models.AdminUserViewModel>
@using HeimevernetInnlevering1.Models
@{
    ViewData["Title"] = "Administrer brukere";
}
<section class="account-card admin-card" aria-labelledby="admin-heading">
    <h1 id="admin-heading">Administrer brukere</h1>
    <p>Kriseledelsen tildeler roller. Rolleendringer avslutter brukerens eksisterende innlogging.</p>
    @if (TempData["AdminMessage"] is string message)
    {
        <p class="account-notice" role="status">@message</p>
    }
    @if (TempData["AdminError"] is string error)
    {
        <p class="account-error" role="alert">@error</p>
    }
    <div class="admin-users">
        @foreach (var user in Model)
        {
            <article class="admin-user">
                <div>
                    <h2>@user.Email</h2>
                    <p>@(user.Role is null ? "Ingen rolle" : AppRoles.Label(user.Role))</p>
                </div>
                <form asp-action="SetRole" method="post">
                    <input type="hidden" name="id" value="@user.Id" />
                    <label>Rolle
                        <select name="role">
                            @foreach (var role in AppRoles.All)
                            {
                                <option value="@role" selected="@(role == user.Role)">@AppRoles.Label(role)</option>
                            }
                        </select>
                    </label>
                    <button type="submit" class="account-button" aria-label="Lagre rolle for @user.Email">Lagre rolle</button>
                </form>
            </article>
        }
    </div>
</section>
