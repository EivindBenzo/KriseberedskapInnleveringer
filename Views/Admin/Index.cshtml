@model IReadOnlyList<HeimevernetInnlevering1.Models.AdminUserViewModel>
@using HeimevernetInnlevering1.Models
@{
    ViewData["Title"] = "Brukere";
    string Key(string? r) => r == AppRoles.Kriseledelse ? "krise" : r == AppRoles.Ressursleverandor ? "leverandor" : r == AppRoles.DispatchTeam ? "dispatch" : "annen";
    string Init(string n) => string.Concat(n.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(d => char.ToUpperInvariant(d[0])));
    var aktive = Model.Count(m => m.Active);
    var rollerIBruk = Model.Select(m => m.Role).Where(r => r != null).Distinct().Count();
    string Sist(DateTime? t)
    {
        if (t is not { } x) return "Aldri";
        var d = DateTime.UtcNow - x;
        return d.TotalMinutes < 60 ? $"{Math.Max(1, (int)d.TotalMinutes)} min siden" : d.TotalHours < 24 ? $"{(int)d.TotalHours} t siden" : d.TotalDays < 2 ? "I går" : x.ToLocalTime().ToString("dd.MM.yyyy");
    }
}
<section class="bu" aria-labelledby="admin-heading">
    <div class="bu-hero">
        <span class="bu-ico"><svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.500"/><path d="M2.500 20c0-3.500 3-5.500 6.500-5.500s6.500 2 6.500 5.500"/><circle cx="17" cy="9" r="2.500"/><path d="M17 14.500c2.500 0 4.500 1.500 4.500 4.500"/></svg></span>
        <div><h1 id="admin-heading">Brukere</h1><p>Kriseledelse administrerer tilgang til Beredskapsportalen, og tildeler roller og rettigheter til brukere.</p></div>
        <svg class="bu-wave" viewBox="0 0 520 140" preserveAspectRatio="none" aria-hidden="true"><path d="M0 100c60-30 110 30 180 0s120-40 190-10 100 20 150-10v60H0z" fill="#cfe7e6"/><path d="M0 120c70-25 120 20 190-5s120-30 190 0 90 10 140-5v30H0z" fill="#b6d9da"/></svg>
    </div>
    @if (TempData["AdminMessage"] is string message) { <p class="account-notice" role="status">@message</p> }
    @if (TempData["AdminError"] is string error) { <p class="account-error" role="alert">@error</p> }
    <div class="bu-stats">
        <div class="bu-stat"><span class="bu-si is-a"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="9" cy="8" r="3.500"/><path d="M2.500 20c0-3.500 3-5.500 6.500-5.500s6.500 2 6.500 5.500"/></svg></span><div><small>Totalt antall brukere</small><strong>@Model.Count</strong></div></div>
        <div class="bu-stat"><span class="bu-si is-b"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg></span><div><small>Aktive brukere</small><strong>@aktive</strong></div></div>
        <div class="bu-stat"><span class="bu-si is-c"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/></svg></span><div><small>Inaktive brukere</small><strong>@(Model.Count - aktive)</strong></div></div>
        <div class="bu-stat"><span class="bu-si is-d"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.500 8 8 9 4.500-1 8-4 8-9V6z"/></svg></span><div><small>Roller i bruk</small><strong>@rollerIBruk</strong></div></div>
    </div>
    <div class="bu-tools">
        <label class="bu-search"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.500-3.500"/></svg><input type="search" id="buSearch" placeholder="Søk etter navn, organisasjon eller e-post…" aria-label="Søk i brukere" autocomplete="off" /></label>
        <select id="buRole" aria-label="Rolle"><option value="">Alle roller</option>@foreach (var r in AppRoles.All) { <option value="@r">@AppRoles.Label(r)</option> }</select>
        <select id="buStatus" aria-label="Status"><option value="">Alle statuser</option><option value="aktiv">Aktiv</option><option value="inaktiv">Inaktiv</option></select>
        <a class="bu-add" asp-controller="Account" asp-action="Register">+ Legg til bruker</a>
    </div>
    <div class="bu-table" role="table" aria-label="Brukere">
        <div class="bu-row bu-th" role="row"><span>Bruker</span><span>Organisasjon</span><span>Rolle</span><span>Status</span><span>Sist aktiv</span><span>Handlinger</span></div>
        @foreach (var user in Model)
        {
            <div class="bu-row" role="row" data-bu data-role="@user.Role" data-status="@(user.Active ? "aktiv" : "inaktiv")" data-search="@($"{user.Navn} {user.Organisasjon} {user.Email}".ToLowerInvariant())">
                <span class="bu-user"><span class="kl-avatar is-@Key(user.Role)">@Init(user.Navn)</span><span><strong>@user.Navn</strong><small>@user.Email</small></span></span>
                <span class="bu-org"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 9h1M14 9h1M9 13h1M14 13h1"/></svg>@(user.Organisasjon ?? "–")</span>
                <span><span class="bu-chip is-@Key(user.Role)">@(user.Role is null ? "Ingen rolle" : AppRoles.Label(user.Role))</span></span>
                <span><span class="bu-status @(user.Active ? "is-on" : "is-off")">@(user.Active ? "Aktiv" : "Inaktiv")</span></span>
                <span class="bu-last">@Sist(user.LastActive)</span>
                <span class="bu-actions">
                    <details class="bu-edit">
                        <summary aria-label="Endre rolle for @user.Email"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.500 3.500a2.100 2.100 0 0 1 3 3L7 19l-4 1 1-4z"/></svg></summary>
                        <form asp-action="SetRole" method="post">
                            <input type="hidden" name="id" value="@user.Id" />
                            <label>Rolle
                                <select name="role">
                                    @foreach (var role in AppRoles.All) { <option value="@role" selected="@(role == user.Role)">@AppRoles.Label(role)</option> }
                                </select>
                            </label>
                            <button type="submit" class="bu-save" aria-label="Lagre rolle for @user.Email">Lagre rolle</button>
                        </form>
                    </details>
                </span>
            </div>
        }
        <p class="empty-state" id="buNone" hidden>Ingen brukere funnet.</p>
    </div>
    <p class="bu-foot">Viser <span id="buCount">@Model.Count</span> av @Model.Count brukere</p>
</section>
<script>
(function () {
    var s = document.getElementById('buSearch'), r = document.getElementById('buRole'), st = document.getElementById('buStatus');
    var rows = [].slice.call(document.querySelectorAll('[data-bu]'));
    function f() {
        var q = s.value.trim().toLowerCase(), n = 0;
        rows.forEach(function (x) {
            var ok = (!q || x.dataset.search.indexOf(q) > -1) && (!r.value || x.dataset.role === r.value) && (!st.value || x.dataset.status === st.value);
            x.hidden = !ok; if (ok) n++;
        });
        document.getElementById('buCount').textContent = n;
        document.getElementById('buNone').hidden = n > 0;
    }
    [s, r, st].forEach(function (e) { e.addEventListener('input', f); });
})();
</script>