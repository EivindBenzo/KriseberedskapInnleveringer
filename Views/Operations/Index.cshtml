@using HeimevernetInnlevering1.Models
@model OperationsViewModel
@{
    ViewData["Title"] = "Forespørsler";
    var provider = User.IsInRole(AppRoles.Ressursleverandor);
    var dispatch = User.IsInRole(AppRoles.DispatchTeam);
    var leader = User.IsInRole(AppRoles.Kriseledelse);
    var publicActor = User.IsInRole(AppRoles.OffentligAktor);
    var actorId = ResourcePermissions.BrukerId(User);
    var now = DateTime.UtcNow;
    var eligibleResources = Model.Resources.Where(r => WorkflowEligibility.IsEligible(r, now)).ToList();
    var active = Model.Requests.Count(f => f.Svar is Statuser.Svar.Venter || (f.Svar == Statuser.Svar.Godtatt && f.Tildeling?.Fullført == null));
    var showRequests = provider || dispatch || leader;
    var showNeeds = publicActor || dispatch || leader || provider;
    var resourceHeading = provider ? "Mine ressurser" : dispatch && !leader ? "Operative ressurser" : "Ressursoversikt";
    bool CanVerify(Ressurs resource) =>
        !Statuser.Ressurs.Opptatt.Contains(resource.Status) && !WorkflowEligibility.HasCurrentApproval(resource, now);
    string Stamp(DateTime value) => value.ToString("dd.MM.yyyy HH:mm") + " UTC";

    // Hvilken seksjon som skal være åpen (?vis=resources eller ?vis=needs). Bestemmes på serveren.
    var vis = ViewBag.Vis as string;
    // Etter en handling sendes brukeren tilbake til samme element på siden (#anker), så siden ikke hopper til toppen.
    string Tilbake(string? seksjon, string anker) => Url.Action("Index", new { vis = seksjon }) + "#" + anker;
}
<section class="operations-workspace" aria-labelledby="operations-heading">
<div class="page-heading">
    <div><span class="eyebrow">Oppfølging og koordinering</span><h1 id="operations-heading">Forespørsler</h1></div>
    @if (provider)
    {
        <a asp-controller="Home" asp-action="Resources" asp-route-mine="true" class="btn-secondary">Mine ressurser</a>
    }
</div>
<nav class="section-nav" aria-label="Arbeidsområder">
    @if (showRequests)
    {
        <a href="#requests">Forespørsler <span class="count-badge">@active</span></a>
        <a href="#assignments">Tildelinger</a>
    }
    <a asp-action="Index" asp-route-vis="resources" asp-fragment="resources">@resourceHeading</a>
    @if (showNeeds)
    {
        <a asp-action="Index" asp-route-vis="needs" asp-fragment="needs">Behov</a>
    }
</nav>
@if (TempData["WorkflowError"] is string error)
{
    <p class="workspace-alert" role="alert">@error</p>
}
@if (TempData["WorkflowSuccess"] is string success)
{
    <p class="notice" role="status">@success</p>
}
<h2 id="requests" hidden="@(!showRequests)">@(provider && !dispatch && !leader ? "Forespørsler til meg" : "Forespørsler og koordinering")</h2>
@if (showRequests && Model.Requests.Count == 0)
{
    <p class="empty-state">@(provider && !dispatch && !leader ? "Du har ingen innkommende forespørsler." : "Ingen forespørsler er sendt.")</p>
}
@foreach (var request in Model.Requests.OrderBy(f => f.Svar is Statuser.Svar.Venter or Statuser.Svar.Godtatt ? 0 : 1))
{
    <div class="workflow-item" id="foresporsel-@request.ForespørselID">
        <div class="results-heading">
            <h3>@request.Ressurs!.Navn <small class="resource-meta">Forespørsel #@request.ForespørselID</small></h3>
            <span class="status-badge @(request.Svar == Statuser.Svar.Venter ? "status-warning" : "")">@Statuser.Visning(request.Svar)@(request.Tildeling is not null ? " · tildelt" : "")</span>
        </div>
        <p>@request.Behov!.Stedsnavn · @request.Antall.ToString("0.##") @request.Ressurs!.Enhet · Behov #@request.BehovID · sendt @Stamp(request.Sendt)</p>
        <details>
            <summary>Om behovet</summary>
            <p>@request.Behov.Beskrivelse</p>
        </details>
        @if (provider && request.Svar == Statuser.Svar.Venter && request.Ressurs.EierID == actorId)
        {
            <form asp-action="Respond" method="post">
                <input type="hidden" name="id" value="@request.ForespørselID" />
                <input type="hidden" name="returnUrl" value="@Tilbake(null, "foresporsel-" + request.ForespørselID)" />
                <label>Kommentar (valgfritt) <input name="reason" maxlength="1000" /></label>
                <button name="accept" value="true" type="submit" class="btn-submit">Godta</button>
                <button name="accept" value="false" type="submit">Avslå</button>
            </form>
        }
        @if (dispatch && request.Svar == Statuser.Svar.Godtatt && request.Tildeling is null)
        {
            <form asp-action="Allocate" method="post">
                <input type="hidden" name="id" value="@request.ForespørselID" />
                <input type="hidden" name="returnUrl" value="@Tilbake(null, "foresporsel-" + request.ForespørselID)" />
                <button type="submit" class="btn-submit">Opprett tildeling</button>
            </form>
        }
        @if (dispatch && request.Tildeling is null && request.Svar is Statuser.Svar.Venter or Statuser.Svar.Godtatt)
        {
            <details>
                <summary>Avbryt forespørsel</summary>
                <form asp-action="Cancel" method="post">
                    <input type="hidden" name="id" value="@request.ForespørselID" />
                <input type="hidden" name="returnUrl" value="@Tilbake(null, "foresporsel-" + request.ForespørselID)" />
                    <label>Begrunnelse <input name="reason" required maxlength="1000" /></label>
                    <button type="submit" class="btn-danger">Avbryt forespørsel</button>
                </form>
            </details>
        }
    </div>
}
<h2 id="assignments" hidden="@(!showRequests)">Tildelinger</h2>
@if (showRequests && Model.Assignments.Count == 0)
{
    <p class="empty-state">Ingen tildelinger ennå.</p>
}
@foreach (var assignment in Model.Assignments.OrderBy(t => t.Fremdrift == Statuser.Fremdrift.Fullført ? 1 : 0))
{
    var next = WorkflowTransitions.NextAssignmentStep(assignment.Fremdrift);
    <div class="workflow-item" id="tildeling-@assignment.TildelingID">
        <div class="results-heading">
            <h3>@assignment.Forespørsel!.Ressurs!.Navn <small class="resource-meta">Tildeling #@assignment.TildelingID</small></h3>
            <span class="status-badge">@Statuser.Visning(assignment.Fremdrift)</span>
        </div>
        <p>@assignment.Forespørsel.Behov!.Stedsnavn · Behov #@assignment.Forespørsel.BehovID · sist oppdatert @Stamp(assignment.SistOppdatert)</p>
        @if (dispatch && next is not null)
        {
            <form asp-action="Assignment" method="post">
                <input type="hidden" name="id" value="@assignment.TildelingID" />
                <input type="hidden" name="returnUrl" value="@Tilbake(null, "tildeling-" + assignment.TildelingID)" />
                <input type="hidden" name="status" value="@next" />
                <label>Kommentar (valgfritt) <input name="reason" maxlength="1000" /></label>
                <button type="submit" class="btn-submit">Sett til @next</button>
            </form>
        }
    </div>
}
<details class="workflow-section" id="resources" open="@(vis == "resources")">
<summary>@resourceHeading <span class="count-badge">@Model.Resources.Count</span></summary>
@if (Model.Resources.Count == 0)
{
    <p>Ingen ressurser å vise.</p>
}
@foreach (var resource in Model.Resources)
{
    var godkjentTil = WorkflowEligibility.GodkjentTil(resource);
    <div class="workflow-item" id="ressurs-@resource.RessursID">
        <h3>@resource.Navn</h3>
        <p class="resource-meta">@resource.Ressurstype?.Navn · @resource.Stedsnavn · @resource.TilgjengeligAntall.ToString("0.##") av @resource.Antall.ToString("0.##") @resource.Enhet tilgjengelig</p>
        <span class="status-badge @(resource.Status == Statuser.Ressurs.Tilgjengelig ? "status-positive" : "status-warning")">@Statuser.Visning(resource.Status)</span>
        <details>
            <summary>@(provider && resource.EierID == actorId ? "Detaljer og tilgjengelighet" : "Detaljer")</summary>
            <p>Beskrivelse: @(resource.Beskrivelse ?? "Ikke oppgitt") · Kontakt: @resource.Kontaktperson, @resource.Kontakttelefon</p>
            @if (godkjentTil.HasValue)
            {
                <p>Godkjenning gjelder til @Stamp(godkjentTil.Value)</p>
            }
            @if (provider && resource.EierID == actorId && resource.Status is Statuser.Ressurs.Tilgjengelig or Statuser.Ressurs.Utilgjengelig)
            {
                <form asp-action="Availability" method="post">
                    <input type="hidden" name="id" value="@resource.RessursID" />
                    <input type="hidden" name="returnUrl" value="@Tilbake("resources", "ressurs-" + resource.RessursID)" />
                    <label>Tilgjengelighet
                        <select name="available">
                            <option value="true" selected="@(resource.Status == Statuser.Ressurs.Tilgjengelig)">Tilgjengelig</option>
                            <option value="false" selected="@(resource.Status == Statuser.Ressurs.Utilgjengelig)">Utilgjengelig</option>
                        </select>
                    </label>
                    <label>Kommentar (valgfritt) <input name="reason" maxlength="1000" /></label>
                    <button type="submit">Lagre tilgjengelighet</button>
                </form>
            }
        </details>
        @if (dispatch && CanVerify(resource))
        {
            <form asp-action="Verify" method="post">
                <input type="hidden" name="id" value="@resource.RessursID" />
                <input type="hidden" name="returnUrl" value="@Tilbake("resources", "resources")" />
                <label>Begrunnelse (kreves ved avvisning) <input name="reason" maxlength="1000" /></label>
                @if (resource.EierID != actorId)
                {
                    <button name="approve" value="true" type="submit">Godkjenn</button>
                }
                else
                {
                    <span>En annen dispatch-bruker må godkjenne din ressurs.</span>
                }
                <button name="approve" value="false" type="submit">Avvis</button>
            </form>
        }
    </div>
}
</details>
<details class="workflow-section" id="needs" hidden="@(!showNeeds)" open="@(vis == "needs")">
<summary>Behov og fremdrift <span class="count-badge">@Model.Needs.Count</span></summary>
@if (publicActor)
{
    <p><a asp-controller="Behov" asp-action="Registrer" class="btn-submit">+ Meld nytt behov</a></p>
}
@if (Model.Needs.Count == 0)
{
    <p>Ingen behov å vise.</p>
}
@foreach (var need in Model.Needs)
{
    <div class="workflow-item" id="behov-@need.BehovID">
        <h3>Behov #@need.BehovID – @need.Behovstype?.Navn · @need.Stedsnavn</h3>
        <p>@need.Beskrivelse</p>
        <p class="resource-meta">Antall: @need.Antall@(need.Frist is DateTime frist ? " · frist " + Stamp(frist) : "")@(need.Hendelse is Hendelse h ? " · " + h.Navn : "")</p>
        <span class="status-badge @(need.Prioritet == Statuser.Prioritet.Akutt ? "status-critical" : "")">@Statuser.Visning(need.Prioritet)</span>
        <span class="status-badge">@Statuser.Visning(need.Status)</span>
        @if (leader && WorkflowTransitions.IsActive(need.Status))
        {
            <form asp-action="Prioritize" method="post">
                <input type="hidden" name="id" value="@need.BehovID" />
                <input type="hidden" name="returnUrl" value="@Tilbake("needs", "behov-" + need.BehovID)" />
                <label>Prioritet <select name="priority">
                    @foreach (var priority in Statuser.Prioritet.Alle.Where(p => p != need.Prioritet))
                    {
                        <option value="@priority">@Statuser.Visning(priority)</option>
                    }
                </select></label>
                <label>Begrunnelse <input name="reason" required maxlength="1000" /></label>
                <button type="submit">Endre prioritet</button>
            </form>
            var muligeStatuser = Statuser.Behov.Alle.Where(st => WorkflowTransitions.CanMoveNeed(need.Status, st)).ToList();
            @if (muligeStatuser.Count > 0)
            {
                <form asp-action="NeedStatus" method="post">
                    <input type="hidden" name="id" value="@need.BehovID" />
                <input type="hidden" name="returnUrl" value="@Tilbake("needs", "behov-" + need.BehovID)" />
                    <label>Ny status <select name="status">
                        @foreach (var status in muligeStatuser)
                        {
                            <option value="@status">@Statuser.Visning(status)</option>
                        }
                    </select></label>
                    <label>Begrunnelse <input name="reason" required maxlength="1000" /></label>
                    <button type="submit">Oppdater status</button>
                </form>
            }
        }
        @if (dispatch && need.Status is Statuser.Behov.Ny or Statuser.Behov.Vurderes)
        {
            <details>
                <summary>Send ressursforespørsel</summary>
                @if (eligibleResources.Count == 0)
                {
                    <p>Ingen tilgjengelige ressurser med gyldig godkjenning.</p>
                }
                @foreach (var resource in eligibleResources)
                {
                    <form asp-action="CreateRequest" method="post">
                        <input type="hidden" name="needId" value="@need.BehovID" />
                        <input type="hidden" name="resourceId" value="@resource.RessursID" />
                        <input type="hidden" name="returnUrl" value="@Tilbake("needs", "behov-" + need.BehovID)" />
                        <span>@resource.Navn – @resource.Ressurstype?.Navn – @resource.TilgjengeligAntall.ToString("0.##") @resource.Enhet tilgjengelig</span>
                        <label>Antall <input type="number" name="quantity" min="0.01" max="@resource.TilgjengeligAntall.ToString(System.Globalization.CultureInfo.InvariantCulture)" step="0.01" value="1" required /></label>
                        <button type="submit">Send til ressurseier</button>
                    </form>
                }
            </details>
        }
    </div>
}
</details>
@if (leader)
{
    <div>
    <details class="workflow-section">
    <summary>Hendelseslogg (siste 100)</summary>
    @if (Model.Audit.Count == 0)
    {
        <p>Ingen handlinger er loggført.</p>
    }
    <div class="audit-scroll" tabindex="0" role="region" aria-label="Hendelseslogg">
    <table>
        <thead><tr><th>Tid (UTC)</th><th>Utført av</th><th>Handling</th><th>Ressurs / behov / forespørsel</th><th>Begrunnelse</th></tr></thead>
        <tbody>
        @foreach (var entry in Model.Audit)
        {
            <tr><td>@entry.Tidspunkt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@Model.ActorNames.GetValueOrDefault(entry.UtførtAvID, "#" + entry.UtførtAvID)</td>
                <td>@WorkflowLabels.Action(entry.Handling)</td>
                <td>@entry.RessursID / @entry.BehovID / @entry.ForespørselID</td><td>@entry.Begrunnelse</td></tr>
        }
        </tbody>
    </table>
    </div>
    </details>
    </div>
}
</section>
