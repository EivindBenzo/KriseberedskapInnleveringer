@{
    var canUseOperations = User.Identity?.IsAuthenticated == true
        && !string.IsNullOrEmpty(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
        && HeimevernetInnlevering1.Models.AppRoles.HasAny(User);
    var tema = HeimevernetInnlevering1.Controllers.TemaController.Gjeldende(Context.Request);
    var mørk = tema == HeimevernetInnlevering1.Controllers.TemaController.Mørk;
    var gjeldendeSide = Context.Request.Path + Context.Request.QueryString;

    // Markerer menypunktet for siden brukeren er på (aria-current="page"). Razor dropper attributtet når verdien er null.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string? Aktiv(string c, params string[] actions) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && actions.Any(a => string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "page" : null;
}
<!DOCTYPE html>
<html lang="no" data-theme="@tema">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beredskapsportalen</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Hopp til innhold</a>
    <header>
        <nav class="navbar" aria-label="Hovedmeny">
            <div class="nav-container">
                <a asp-controller="Home" asp-action="Index" class="nav-brand" aria-label="Hjem">
                    <img src="~/images/forsvaret-logo.png" asp-append-version="true" alt="" width="588" height="721" />
                    <span>Beredskapsportalen<small>Studentprosjekt · prototype</small></span>
                </a>

                @* Menyen åpnes og lukkes med en avkrysningsboks og CSS (site.css), uten JavaScript. *@
                <input type="checkbox" id="menuToggle" class="menu-checkbox" aria-controls="navMenu" />

                <div class="nav-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* Innloggede bytter tema og logger ut fra kontosiden. *@
                    <a asp-controller="Account" asp-action="Profile" class="nav-profile" aria-label="Min konto" title="Min konto" aria-current="@Aktiv("Account", "Profile")">
                        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="12" cy="8" r="4" fill="currentColor"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7z" fill="currentColor"/></svg>
                    </a>
                }
                else
                {
                    <form asp-controller="Tema" asp-action="Bytt" method="post">
                        <input type="hidden" name="returnUrl" value="@gjeldendeSide" />
                        <button type="submit" class="theme-toggle" aria-label="@(mørk ? "Bytt til lys modus" : "Bytt til mørk modus")">
                            <span aria-hidden="true">@(mørk ? "☾" : "☀")</span>
                            <span>@(mørk ? "Mørk modus" : "Lys modus")</span>
                        </button>
                    </form>
                }
                <label for="menuToggle" class="menu-toggle" aria-label="Meny">
                    <span></span>
                    <span></span>
                    <span></span>
                </label>
                </div>

                <ul class="nav-menu" id="navMenu">
                    <li><a asp-controller="Home" asp-action="Index" class="nav-link" aria-current="@Aktiv("Home", "Index")">Hjem</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li><a asp-controller="Home" asp-action="Dashboard" class="nav-link" aria-current="@Aktiv("Home", "Dashboard")">Oversikt</a></li>
                        <li><a asp-controller="Home" asp-action="Map" class="nav-link" aria-current="@Aktiv("Home", "Map")">Kart</a></li>
                        <li><a asp-controller="Home" asp-action="Resources" class="nav-link" aria-current="@Aktiv("Home", "Resources", "Mine", "Edit", "Delete")">Ressurser</a></li>
                        @if (User.IsInRole(HeimevernetInnlevering1.Models.AppRoles.OffentligAktor))
                        {
                            <li><a asp-controller="Behov" asp-action="Registrer" class="nav-link" aria-current="@Aktiv("Behov", "Registrer")">Meld behov</a></li>
                        }
                        @if (User.IsInRole(HeimevernetInnlevering1.Models.AppRoles.Kriseledelse)
                            || User.IsInRole(HeimevernetInnlevering1.Models.AppRoles.DispatchTeam))
                        {
                            <li><a asp-controller="Hendelse" asp-action="Index" class="nav-link" aria-current="@Aktiv("Hendelse", "Index")">Hendelser</a></li>
                        }
                        @if (User.IsInRole(HeimevernetInnlevering1.Models.AppRoles.Kriseledelse))
                        {
                            <li><a asp-controller="Admin" asp-action="Index" class="nav-link" aria-current="@Aktiv("Admin", "Index")">Brukere</a></li>
                        }
                        @if (canUseOperations)
                        {
                            <li><a asp-controller="Home" asp-action="Contacts" class="nav-link" aria-current="@Aktiv("Home", "Contacts")">Kontaktliste</a></li>
                        }
                    }
                    else
                    {
                        <li><a asp-controller="Account" asp-action="Login" class="nav-link" aria-current="@Aktiv("Account", "Login")">Logg inn</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="nav-link" aria-current="@Aktiv("Account", "Register")">Registrer bruker</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main id="main" class="main-content" tabindex="-1">
        @RenderBody()
    </main>

</body>
</html>
