@using HeimevernetInnlevering1.Controllers
@using HeimevernetInnlevering1.Models
@using HeimevernetInnlevering1.Services
@inject ShellService Shell
@{
    var shell = await Shell.HentAsync(User);
    var tema = TemaController.Gjeldende(Context.Request);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var driftsrolle = User.IsInRole(AppRoles.DispatchTeam) || User.IsInRole(AppRoles.Kriseledelse);
    var kanForespørsler = driftsrolle || User.IsInRole(AppRoles.Ressursleverandor);
    string? Aktiv(string c, string a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) && string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    Microsoft.AspNetCore.Html.IHtmlContent Ikon(string sti) =>
        new Microsoft.AspNetCore.Html.HtmlString($"<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">{sti}</svg>");
}
<!DOCTYPE html>
<html lang="no" data-theme="@tema">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Beredskapsportalen</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
</head>
<body class="shell-body">
    <a class="skip-link" href="#main">Hopp til innhold</a>
    <div class="shell">
        <aside class="shell-side" id="shellSide">
            <a asp-controller="Home" asp-action="Index" class="shell-brand" aria-label="Hjem">
                <img src="~/images/forsvaret-logo.png" asp-append-version="true" alt="" width="588" height="721" />
                <span>Beredskapsportalen<small>Studentprosjekt · prototype</small></span>
            </a>
            <nav class="shell-nav" aria-label="Hovedmeny">
                <a asp-controller="Home" asp-action="Dashboard" aria-current="@Aktiv("Home", "Dashboard")">@Ikon("<rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1.5\"/>")<span>Oversikt</span></a>
                <a asp-controller="Home" asp-action="Map" aria-current="@Aktiv("Home", "Map")">@Ikon("<path d=\"M12 21s7-6.2 7-12a7 7 0 0 0-14 0c0 5.800 7 12 7 12z\"/><circle cx=\"12\" cy=\"9\" r=\"2.500\"/>")<span>Kart</span></a>
                @if (driftsrolle)
                {
                    <a asp-controller="Hendelse" asp-action="Index" aria-current="@Aktiv("Hendelse", "Index")">@Ikon("<path d=\"M10.300 3.900 1.800 18a2 2 0 0 0 1.700 3h17a2 2 0 0 0 1.700-3L13.700 3.900a2 2 0 0 0-3.400 0z\"/><path d=\"M12 9v4M12 17h.01\"/>")<span>Hendelser</span>@if (shell.AktiveHendelser > 0) { <b>@shell.AktiveHendelser</b> }</a>
                }
                <a asp-controller="Home" asp-action="Resources" aria-current="@Aktiv("Home", "Resources")">@Ikon("<path d=\"M21 8 12 3 3 8v8l9 5 9-5z\"/><path d=\"m3 8 9 5 9-5M12 13v8\"/>")<span>Ressurser</span></a>
                @if (User.IsInRole(AppRoles.OffentligAktor))
                {
                    <a asp-controller="Behov" asp-action="Registrer" aria-current="@Aktiv("Behov", "Registrer")">@Ikon("<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8v8M8 12h8\"/>")<span>Meld behov</span></a>
                }
                @if (kanForespørsler)
                {
                }
                <a asp-controller="Messages" asp-action="Inbox" aria-current="@Aktiv("Messages", "Inbox")">@Ikon("<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"m3 7 9 6 9-6\"/>")<span>Meldinger</span>@if (shell.Meldinger > 0) { <b>@shell.Meldinger</b> }</a>
                @if (User.IsInRole(AppRoles.Kriseledelse))
                {
                    <a asp-controller="Admin" asp-action="Index" aria-current="@Aktiv("Admin", "Index")">@Ikon("<circle cx=\"9\" cy=\"8\" r=\"3.500\"/><path d=\"M2 20c0-3.500 3-6 7-6s7 2.500 7 6M17 11a3 3 0 1 0 0-6M22 20c0-2.800-1.800-4.800-4.500-5.600\"/>")<span>Brukere</span></a>
                }
                <a asp-controller="Home" asp-action="Contacts" aria-current="@Aktiv("Home", "Contacts")">@Ikon("<path d=\"M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z\"/>")<span>Kontaktliste</span></a>
                <a asp-controller="Account" asp-action="Profile" aria-current="@Aktiv("Account", "Profile")">@Ikon("<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4.400 3.600-7 8-7s8 2.600 8 7\"/>")<span>Profil</span></a>
            </nav>
            <a asp-controller="Home" asp-action="Index" class="shell-help">@Ikon("<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M9.500 9a2.500 2.500 0 1 1 3.500 2.300c-.8.4-1 1-1 1.700M12 17h.01\"/>")<span>Hjelp og støtte<small>Om portalen</small></span></a>
        </aside>
        <div class="shell-main">
            <header class="shell-top">
                <label for="shellMenu" class="shell-burger" aria-label="Meny"><span></span><span></span><span></span></label>
                <input type="checkbox" id="shellMenu" class="shell-menu-check" />
                <div class="shell-title">
                    <span class="shell-title-icon" aria-hidden="true">@Ikon("<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21c0-4.400 3.600-7 8-7s8 2.600 8 7\"/>")</span>
                    <div><h1>@ViewData["PageTitle"]</h1><p>@ViewData["PageSubtitle"]</p></div>
                </div>
                <partial name="_UserMenu" />
            </header>
            <main id="main" class="shell-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/js/profile.js" asp-append-version="true"></script>
</body>
</html>
