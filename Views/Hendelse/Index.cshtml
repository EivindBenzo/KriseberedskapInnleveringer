@model HeimevernetInnlevering1.Controllers.HendelseSkjemaViewModel
@using HeimevernetInnlevering1.Models
@using HeimevernetInnlevering1.ViewModels
@{
    ViewData["Title"] = "Hendelser";
    var hendelser = (ViewBag.Hendelser as List<Hendelse>) ?? new();
    var kort = (ViewBag.Kort as Dictionary<int, HendelseKort>) ?? new();
    var siste = (ViewBag.Siste as List<HendelseLoggRad>) ?? new();
    var kriseledelse = User.IsInRole(AppRoles.Kriseledelse);
    var hovedId = ViewBag.HovedId as int?;
    var featured = hendelser.FirstOrDefault(h => h.HendelseID == hovedId);
    var festet = (ViewBag.Festet as HashSet<int>) ?? new();
    var antallAktiv = hendelser.Count(h => h.Status == Statuser.Hendelse.Aktiv);
    var antallPlan = hendelser.Count(h => h.Status == Statuser.Hendelse.Planlagt);
    var antallFerdig = hendelser.Count(h => h.Status == Statuser.Hendelse.Avsluttet);
    var andre = hendelser.Where(h => h != featured).ToList();
    string Stamp(DateTime v) => v.ToString("dd.MM.yyyy HH:mm") + " UTC";
    string StatusKlasse(string s) => s == Statuser.Hendelse.Aktiv ? "is-orange" : s == Statuser.Hendelse.Planlagt ? "is-blue" : "is-grey";
    string PrioKlasse(string p) => p == Statuser.HendelsePrioritet.Hoy ? "is-red" : p == Statuser.HendelsePrioritet.Medium ? "is-yellow" : "is-green";
    string PrioTekst(string p) => p == Statuser.HendelsePrioritet.Hoy ? "Høy prioritet" : p == Statuser.HendelsePrioritet.Medium ? "Medium prioritet" : "Lav prioritet";
    string PrioIkon(string p) => p == Statuser.HendelsePrioritet.Hoy ? "↑" : p == Statuser.HendelsePrioritet.Medium ? "=" : "↓";
    // Ikon for hendelsestype, avledet av ord i navn og beskrivelse. Alt som ikke passer får «annet».
    string TypeIkon(Hendelse h)
    {
        var s = ((h.Navn ?? "") + " " + (h.Beskrivelse ?? "")).ToLowerInvariant();
        bool Har(params string[] ord) => ord.Any(s.Contains);
        if (Har("flom", "oversvøm", "overvann", "høy vannstand")) return "<path d=\"M2 8c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 14c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2M2 20c2.5 0 2.5-2 5-2s2.5 2 5 2 2.5-2 5-2 2.5 2 5 2\"/>";
        if (Har("regn", "nedbør", "styrtregn", "skybrudd")) return "<path d=\"M16 13v8M8 13v8M12 15v8M20 16.6A5 5 0 0 0 18 7h-1.3A8 8 0 1 0 4 14.3\"/>";
        if (Har("brann", "ild", "skogbrann", "gressbrann")) return "<path d=\"M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.4-.5-2-1-3-1.1-2.1-.2-4 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.2.4-2.3 1-3a2.5 2.5 0 0 0 2.5 2.5z\"/>";
        if (Har("skred", "ras", "jordskjelv", "leire")) return "<path d=\"m8 3 4 8 5-5 5 15H2z\"/>";
        if (Har("storm", "orkan", "vind", "uvær")) return "<path d=\"M17.7 7.7a2.5 2.5 0 1 1 1.8 4.3H2M9.6 4.6A2 2 0 1 1 11 8H2M12.6 19.4A2 2 0 1 0 14 16H2\"/>";
        if (Har("snø", "snøfall", "is ", "ising", "kulde", "vinter")) return "<path d=\"M2 12h20M12 2v20M4.9 4.9l14.2 14.2M19.1 4.9 4.9 19.1\"/>";
        if (Har("strøm", "blackout", "kraft", "nettbrudd")) return "<path d=\"M13 2 3 14h9l-1 8 10-12h-9z\"/>";
        if (Har("øvelse", "øving", "trening")) return "<circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"6\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/>";
        return "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4M12 8h.01\"/>";
    }
}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
<section class="hx" aria-labelledby="incident-heading">
    <header class="hx-head hx-banner">
        <div class="hx-banner-text">
            <span class="iw-eyebrow">HENDELSER</span>
            <h1 id="incident-heading">Hendelser</h1>
            <p>Følg opp og koordiner pågående hendelser.</p>
            @if (kriseledelse)
            {
                <a class="hx-new" href="#ny-hendelse">+ Ny hendelse</a>
            }
        </div>
        <div class="hx-tiles">
            <div class="hx-tilebox"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></svg><strong>@antallAktiv</strong><span>Pågående</span></div>
            <div class="hx-tilebox"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><strong>@antallPlan</strong><span>Planlagt</span></div>
            <div class="hx-tilebox"><svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg><strong>@antallFerdig</strong><span>Avsluttede</span></div>
        </div>
    </header>
    @if (TempData["WorkflowError"] is string error) { <p class="workspace-alert" role="alert">@error</p> }
    @if (TempData["WorkflowSuccess"] is string success) { <p class="notice" role="status">@success</p> }

    @if (featured is not null)
    {
        var k = kort.GetValueOrDefault(featured.HendelseID) ?? new HendelseKort(0, 0, 0, 0, 0, 0);
        <article class="hx-feature @StatusKlasse(featured.Status)">
            <div class="hx-feature-main">
                <div class="hx-title">
                    <i class="hx-tile"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(TypeIkon(featured))</svg></i>
                    <div>
                        <h2>@featured.Navn</h2>
                        <div class="hx-chips"><span class="hx-chip @StatusKlasse(featured.Status)">@Statuser.Hendelse.Etikett(featured.Status)</span><span class="hx-chip @PrioKlasse(featured.Prioritet)">@PrioTekst(featured.Prioritet)</span></div>
                        <p class="hx-meta">@featured.Område · Opprettet @Stamp(featured.Starttidspunkt)</p>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(featured.Beskrivelse)) { <p class="hx-desc">@featured.Beskrivelse</p> }
                <div class="hx-actions">
                    <a class="hx-btn-solid" asp-action="Arbeidsrom" asp-route-id="@featured.HendelseID">Åpne arbeidsrom ↗</a>
                    <a class="hx-btn-line" asp-controller="Home" asp-action="Map" asp-route-sted="@featured.Område">Se på kart ↗</a>
                    @if (kriseledelse) { @await Html.PartialAsync("_HendelseKontroll", featured) }
                </div>
            </div>
            <div class="hx-feature-mid">
                <h3>Fremdrift i håndtering</h3>
                <div class="hx-bar"><div class="hx-bar-track"><span style="width:@k.Prosent%"></span></div><b>@k.Prosent %</b></div>
                <div class="hx-stats">
                    <div><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2M15 18H9M19 18h2a1 1 0 0 0 1-1v-3.7a1 1 0 0 0-.2-.6l-3.3-4.1a1 1 0 0 0-.8-.4H14"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg><span>Ressurser i bruk</span><strong>@k.Ressurser</strong></div>
                    <div><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-6"/></svg><span>Tiltak fullført</span><strong>@k.TiltakFerdig / @k.Tiltak</strong></div>
                    <div><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM22 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg><span>Involverte aktører</span><strong>@k.Aktører</strong></div>
                    <div><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></svg><span>Åpne behov</span><strong>@k.Behov</strong></div>
                </div>
            </div>
            <div class="hx-feature-side">
                <h3>Siste aktivitet</h3>
                @if (siste.Count == 0) { <p class="iw-muted">Ingen aktivitet ennå.</p> }
                <ul class="hx-timeline">
                    @foreach (var a in siste)
                    {
                        <li><div><strong>@a.Handling</strong>@if (!string.IsNullOrWhiteSpace(a.Tekst)) { <span>@a.Tekst</span> }</div><time>@a.Tidspunkt.ToString("HH:mm")</time></li>
                    }
                </ul>
            </div>
        </article>
    }
    <section class="hx-others">
        <div class="hx-others-head">
            <h2>Andre hendelser (<span id="hxCount">@andre.Count</span>)</h2>
            <div class="hx-filters" role="group" aria-label="Filter">
                <button type="button" class="is-active" data-f="alle">Alle</button>
                <button type="button" data-f="aktiv">Pågår (@andre.Count(h => h.Status == Statuser.Hendelse.Aktiv))</button>
                <button type="button" data-f="planlagt">Planlagt (@andre.Count(h => h.Status == Statuser.Hendelse.Planlagt))</button>
                <button type="button" data-f="avsluttet">Avsluttet (@andre.Count(h => h.Status == Statuser.Hendelse.Avsluttet))</button>
            </div>
            <span class="hx-pincount" title="Festede hendelser">&#128204; Festet <b>@festet.Count</b>/5</span>
            <label class="hx-sort">Sorter <select id="hxSort"><option value="new">Nyest først</option><option value="old">Eldst først</option></select></label>
        </div>
        @if (andre.Count == 0) { <p class="empty-state">Ingen andre hendelser.</p> }
        <div id="hxList">
        @foreach (var h in andre)
        {
            var k = kort.GetValueOrDefault(h.HendelseID) ?? new HendelseKort(0, 0, 0, 0, 0, 0);
            <article class="hx-row @StatusKlasse(h.Status)@(festet.Contains(h.HendelseID) ? " is-pinned" : "")" data-status="@h.Status" data-pin="@(festet.Contains(h.HendelseID) ? 1 : 0)" data-time="@h.Starttidspunkt.Ticks">
                <i class="hx-tile"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(TypeIkon(h))</svg></i>
                <div class="hx-row-name"><strong>@h.Navn</strong><span>@h.Område &nbsp;|&nbsp; @Stamp(h.Starttidspunkt)</span></div>
                <div class="hx-row-chips"><span class="hx-chip @StatusKlasse(h.Status)">@Statuser.Hendelse.Etikett(h.Status)</span><span class="hx-chip @PrioKlasse(h.Prioritet)">@PrioIkon(h.Prioritet) @PrioTekst(h.Prioritet)</span></div>
                <div class="hx-row-progress">
                    @if (h.Status == Statuser.Hendelse.Aktiv)
                    {
                        <div class="hx-bar"><div class="hx-bar-track"><span style="width:@k.Prosent%"></span></div><b>@k.Prosent %</b></div>
                    }
                </div>
                <div class="hx-row-actions">
                    @if (festet.Contains(h.HendelseID))
                    {
                        <form asp-action="Hovedhendelse" asp-route-id="@h.HendelseID" method="post"><button type="submit" class="hx-main-btn" title="Vis denne øverst">☆ Gjør til hovedhendelse</button></form>
                    }
                    @if (h.Status == Statuser.Hendelse.Aktiv) { <form asp-action="Fest" asp-route-id="@h.HendelseID" method="post"><button type="submit" class="hx-pin@(festet.Contains(h.HendelseID) ? " is-on" : "")" title="@(festet.Contains(h.HendelseID) ? "Løsne hendelse" : "Fest øverst")" aria-label="Fest hendelse" aria-pressed="@(festet.Contains(h.HendelseID) ? "true" : "false")"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M16 3a1 1 0 0 1 .7 1.7L15.4 6l1.8 5.3 1.5 1.5a1 1 0 0 1-.7 1.7H13v6l-1 1-1-1v-6H6a1 1 0 0 1-.7-1.7l1.5-1.5L8.6 6 7.3 4.7A1 1 0 0 1 8 3z"/></svg></button></form> }
                    @if (kriseledelse) { @await Html.PartialAsync("_HendelseKontroll", h) }
                    <a class="hx-detail-btn" asp-action="Arbeidsrom" asp-route-id="@h.HendelseID" aria-label="Se detaljer for @h.Navn">Se detaljer <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
                </div>
            </article>
        }
        </div>
    </section>
    @if (kriseledelse)
    {
    <details class="hx-create" id="ny-hendelse" open="@(hendelser.Count == 0 || !ViewData.ModelState.IsValid)">
        <summary>+ Ny hendelse</summary>
        <form asp-action="Index" method="post" class="form-container">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
            <div class="form-group">
                <label asp-for="Navn">Navn <span class="required">*</span></label>
                <input asp-for="Navn" class="form-control" maxlength="150" placeholder="f.eks. Flom i Glomma" required />
                <span asp-validation-for="Navn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Område">Område <span class="required">*</span></label>
                <input asp-for="Område" class="form-control" maxlength="150" placeholder="f.eks. Hamar" required />
                <span asp-validation-for="Område" class="text-danger"></span>
            </div>
            <div class="hx-create-row">
                <div class="form-group">
                    <label asp-for="Prioritet">Prioritet</label>
                    <select asp-for="Prioritet" class="form-control">
                        <option value="lav">Lav prioritet</option><option value="medium">Medium prioritet</option><option value="høy">Høy prioritet</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Status">Status</label>
                    <select asp-for="Status" class="form-control"><option value="aktiv">Pågår</option><option value="planlagt">Planlagt</option></select>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Starttidspunkt">Starttidspunkt <span class="required">*</span></label>
                <input asp-for="Starttidspunkt" type="datetime-local" class="form-control" required />
                <span asp-validation-for="Starttidspunkt" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Beskrivelse">Beskrivelse (valgfritt)</label>
                <textarea asp-for="Beskrivelse" class="form-control" rows="3" maxlength="2000"></textarea>
            </div>
            <button type="submit" class="btn-submit">Opprett hendelse</button>
        </form>
    </details>
    }
</section>
<script src="~/lib/leaflet/leaflet.js"></script>
<script>
(function () {
    var list = document.getElementById('hxList'); if (!list) return;
    var filter = 'alle';
    function apply() {
        var rows = Array.prototype.slice.call(list.children), n = 0, dir = document.getElementById('hxSort').value === 'old' ? 1 : -1;
        rows.sort(function (a, b) { var pd = Number(b.dataset.pin) - Number(a.dataset.pin); if (pd) return pd; return dir * (Number(a.dataset.time) - Number(b.dataset.time)); }).forEach(function (r) {
            var show = filter === 'alle' || r.dataset.status === filter; r.hidden = !show; if (show) n++; list.appendChild(r);
        });
        document.getElementById('hxCount').textContent = n;
    }
    document.querySelectorAll('.hx-filters button').forEach(function (b) {
        b.addEventListener('click', function () {
            document.querySelectorAll('.hx-filters button').forEach(function (x) { x.classList.remove('is-active'); });
            b.classList.add('is-active'); filter = b.dataset.f; apply();
        });
    });
    document.getElementById('hxSort').addEventListener('change', apply);
})();
</script>
