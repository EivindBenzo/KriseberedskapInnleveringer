@model HeimevernetInnlevering1.Models.LoginViewModel
@{
    ViewData["Title"] = "Logg inn";
}
<section class="account-card" aria-labelledby="account-heading">
    <h1 id="account-heading">Logg inn</h1>
    @if (TempData["AccountMessage"] is string message)
    {
        <p class="account-notice" role="status">@message</p>
    }
    <form asp-action="Login" method="post" class="account-form">
        <div asp-validation-summary="ModelOnly" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <label asp-for="Email"></label>
        <input asp-for="Email" type="email" autocomplete="username" required />
        <span asp-validation-for="Email"></span>
        <label asp-for="Password"></label>
        <input asp-for="Password" autocomplete="current-password" required />
        <span asp-validation-for="Password"></span>
        <button class="account-button" type="submit">Logg inn</button>
    </form>
    <p class="account-links">Ny her? <a asp-action="Register">Registrer bruker</a></p>
</section>
